  file_change {
    absolute_path_uri: "file:///src/components/CreditsTable.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { CarbonCredit, CreditStatus } from \'../types\';\nimport { \n  Coins, \n  Search, \n  Filter, \n  Flame, \n  Award, \n  ShieldAlert, \n  CheckCircle2, \n  ShieldX, \n  Eye,\n  FileCheck2\n} from \'lucide-react\';\n\ninterface CreditsTableProps {\n  credits: CarbonCredit[];\n  onOpenRetireModal: (credit: CarbonCredit) => void;\n  onOpenCertificateModal: (credit: CarbonCredit) => void;\n}\n\nexport const CreditsTable: React.FC<CreditsTableProps> = ({\n  credits,\n  onOpenRetireModal,\n  onOpenCertificateModal\n}) => {\n  const [filterStatus, setFilterStatus] = useState<string>(\'ALL\');\n  const [searchTerm, setSearchTerm] = useState<string>(\'\');\n\n  const filteredCredits = credits.filter(credit => {\n    const matchesStatus = filterStatus === \'ALL\' || credit.status === filterStatus;\n    const matchesSearch = \n      credit.id.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      credit.siteName.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      (credit.retiredDetails?.beneficiary || \'\').toLowerCase().includes(searchTerm.toLowerCase());\n    return matchesStatus && matchesSearch;\n  });\n\n  const getStatusBadge = (status: CreditStatus) => {\n    switch (status) {\n      case \'TRADEABLE\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-950 text-emerald-300 border border-emerald-700\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400\"></span>\n            Tradeable Active\n          </span>\n        );\n      case \'BUFFER_RESERVE\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-950 text-amber-300 border border-amber-700\">\n            <ShieldAlert className=\"w-3 h-3 text-amber-400\" />\n            Buffer Held (20%)\n          </span>\n        );\n      case \'RETIRED_OFFSET\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-950 text-indigo-300 border border-indigo-700\">\n            <CheckCircle2 className=\"w-3 h-3 text-indigo-400\" />\n            Retired (Offset Claimed)\n          </span>\n        );\n      case \'REVERSAL_BURNED\':\n        return (\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-950 text-red-300 border border-red-700\">\n            <ShieldX className=\"w-3 h-3 text-red-400\" />\n            Reversal Burned\n          </span>\n        );\n    }\n  };\n\n  return (\n    <div className=\"space-y-4\">\n      \n      {/* Control Bar: Filters & Search */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-col md:flex-row md:items-center justify-between gap-4 shadow-lg\">\n        \n        {/* Status Filter Tabs */}\n        <div className=\"flex flex-wrap items-center gap-1.5 text-xs\">\n          {[\n            { id: \'ALL\', label: \'All Credits\' },\n            { id: \'TRADEABLE\', label: \'Tradeable Active\' },\n            { id: \'BUFFER_RESERVE\', label: \'Buffer Reserve (20%)\' },\n            { id: \'RETIRED_OFFSET\', label: \'Retired Offsets\' },\n            { id: \'REVERSAL_BURNED\', label: \'Reversal Burned\' }\n          ].map((tab) => (\n            <button\n              key={tab.id}\n              onClick={() => setFilterStatus(tab.id)}\n              className={`px-3 py-1.5 rounded-lg font-medium transition-colors cursor-pointer whitespace-nowrap ${\n                filterStatus === tab.id\n                  ? \'bg-emerald-600 text-white\'\n                  : \'bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white\'\n              }`}\n            >\n              {tab.label}\n            </button>\n          ))}\n        </div>\n\n        {/* Search Box */}\n        <div className=\"relative min-w-[240px]\">\n          <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n          <input\n            type=\"text\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            placeholder=\"Search by ID, site, or beneficiary...\"\n            className=\"w-full bg-slate-950 border border-slate-700 rounded-lg pl-9 pr-3 py-1.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500\"\n          />\n        </div>\n\n      </div>\n\n      {/* Credits Table */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-lg\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse\">\n            <thead>\n              <tr className=\"border-b border-slate-800 bg-slate-950/70 text-slate-400 font-semibold uppercase tracking-wider text-[11px]\">\n                <th className=\"py-3 px-4\">Serial Token ID</th>\n                <th className=\"py-3 px-4\">Provenance Site</th>\n                <th className=\"py-3 px-4\">Vintage</th>\n                <th className=\"py-3 px-4\">Volume</th>\n                <th className=\"py-3 px-4\">Registry Status</th>\n                <th className=\"py-3 px-4\">Blockchain Tx</th>\n                <th className=\"py-3 px-4 text-right\">Actions</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/60\">\n              {filteredCredits.length === 0 ? (\n                <tr>\n                  <td colSpan={7} className=\"py-8 text-center text-slate-400 text-xs\">\n                    No carbon credits found matching the active filter.\n                  </td>\n                </tr>\n              ) : (\n                filteredCredits.map((credit) => (\n                  <tr key={credit.id} className=\"hover:bg-slate-800/40 transition-colors\">\n                    \n                    {/* Serial ID */}\n                    <td className=\"py-3 px-4 font-mono font-bold text-white whitespace-nowrap\">\n                      {credit.id}\n                    </td>\n\n                    {/* Site */}\n                    <td className=\"py-3 px-4 text-slate-300 font-medium\">\n                      {credit.siteName}\n                    </td>\n\n                    {/* Vintage */}\n                    <td className=\"py-3 px-4 text-slate-400 font-mono\">\n                      {credit.vintageYear}\n                    </td>\n\n                    {/* Volume */}\n                    <td className=\"py-3 px-4 font-semibold text-emerald-400\">\n                      {credit.tonnage.toFixed(1)} tCO\342\202\202e\n                    </td>\n\n                    {/* Status */}\n                    <td className=\"py-3 px-4 whitespace-nowrap\">\n                      {getStatusBadge(credit.status)}\n                    </td>\n\n                    {/* Tx Hash */}\n                    <td className=\"py-3 px-4 font-mono text-[11px] text-slate-400\">\n                      {credit.mintTxHash.slice(0, 10)}...{credit.mintTxHash.slice(-6)}\n                    </td>\n\n                    {/* Action */}\n                    <td className=\"py-3 px-4 text-right whitespace-nowrap\">\n                      {credit.status === \'TRADEABLE\' && (\n                        <button\n                          onClick={() => onOpenRetireModal(credit)}\n                          className=\"inline-flex items-center gap-1 px-3 py-1 rounded-md text-xs font-semibold bg-orange-600/90 hover:bg-orange-500 text-white transition-colors cursor-pointer\"\n                        >\n                          <Flame className=\"w-3.5 h-3.5\" />\n                          <span>Retire Credit</span>\n                        </button>\n                      )}\n\n                      {credit.status === \'RETIRED_OFFSET\' && (\n                        <button\n                          onClick={() => onOpenCertificateModal(credit)}\n                          className=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-medium bg-indigo-950 text-indigo-300 border border-indigo-700 hover:bg-indigo-900 transition-colors cursor-pointer\"\n                        >\n                          <FileCheck2 className=\"w-3.5 h-3.5 text-indigo-400\" />\n                          <span>View Certificate</span>\n                        </button>\n                      )}\n\n                      {credit.status === \'BUFFER_RESERVE\' && (\n                        <span className=\"text-[11px] text-amber-400/80 font-mono italic\">\n                          Locked in Buffer\n                        </span>\n                      )}\n\n                      {credit.status === \'REVERSAL_BURNED\' && (\n                        <span className=\"text-[11px] text-red-400 font-mono italic\">\n                          Burned in Disturbance\n                        </span>\n                      )}\n                    </td>\n\n                  </tr>\n                ))\n              )}\n            </tbody>\n          </table>\n        </div>\n\n        {/* Footer info */}\n        <div className=\"p-3 bg-slate-950/60 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400\">\n          <span>Showing {filteredCredits.length} serialized credit tokens</span>\n          <span className=\"font-mono text-[11px]\">1 Token = 1 Metric Ton CO\342\202\202e Extinguished / Traded</span>\n        </div>\n      </div>\n\n    </div>\n  );\n};\n"
    }
