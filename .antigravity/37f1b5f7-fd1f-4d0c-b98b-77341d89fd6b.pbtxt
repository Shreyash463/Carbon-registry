    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { \n  BookOpen, \n  ShieldCheck, \n  AlertTriangle, \n  CheckCircle2, \n  Award, \n  Radio, \n  Layers, \n  HelpCircle,\n  ExternalLink,\n  ChevronRight,\n  TrendingDown,\n  Sparkles\n} from \'lucide-react\';\n\nexport const HackathonBriefing: React.FC = () => {\n  return (\n    <div className=\"space-y-6\">\n      \n      {/* Banner */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl\">\n        <div className=\"flex items-center gap-2 text-xs font-bold text-emerald-400 uppercase tracking-wider mb-2\">\n          <BookOpen className=\"w-4 h-4\" />\n          <span>Smart India Hackathon \342\200\242 Problem Statement SIH26193</span>\n        </div>\n        <h2 className=\"text-2xl font-bold text-white tracking-tight\">\n          Blue Carbon Registry: Executive Summary & Judge Pitch\n        </h2>\n        <p className=\"text-xs text-slate-300 mt-2 max-w-3xl leading-relaxed\">\n          India possesses over 4,992 sq km of mangrove forests capable of sequestering up to 4-10x more carbon per hectare than terrestrial tropical rainforests. However, blue carbon credit markets have suffered from <strong>unverified claims, manual audit delays (6-18 months), and catastrophic reversal risks</strong>. This platform solves all three through <strong>automated tri-source MRV consensus and an on-chain buffer-reserve safeguard</strong>.\n        </p>\n      </div>\n\n      {/* 3-Minute Live Demo Pitch Script for Judges */}\n      <div className=\"bg-slate-900 border border-emerald-900/50 rounded-2xl p-6 shadow-xl bg-emerald-950/10\">\n        <div className=\"flex items-center gap-2 text-xs font-bold text-emerald-400 uppercase tracking-wider mb-2\">\n          <Sparkles className=\"w-4 h-4\" />\n          <span>Judges Demonstration Script (Follow this 3-Minute Flow)</span>\n        </div>\n        <h3 className=\"text-lg font-bold text-white mb-4\">\n          How to Present This Live on Screen\n        </h3>\n\n        <div className=\"space-y-4 text-xs\">\n          \n          <div className=\"p-4 rounded-xl bg-slate-950 border border-slate-800\">\n            <div className=\"font-bold text-emerald-300 text-sm mb-1 flex items-center gap-2\">\n              <span className=\"w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs\">1</span>\n              <span>The Problem: The Toucan Protocol Failure (30 seconds)</span>\n            </div>\n            <p className=\"text-slate-300 leading-relaxed pl-7\">\n              \"Judges, in 2021-22, Web3 carbon tokenization platforms like Toucan Protocol tokenized over 20 million carbon credits. But independent investigations found that <strong>over 28% were \'zombie credits\'</strong> \342\200\224 credits issued for forests that had already been clear-cut, degraded, or double-counted years prior. Tokenizing bad data just makes bad carbon fraud faster. We solved the root cause: <strong>Real-time physical MRV consensus before minting, plus an automated Buffer Reserve pool</strong>.\"\n            </p>\n          </div>\n\n          <div className=\"p-4 rounded-xl bg-slate-950 border border-slate-800\">\n            <div className=\"font-bold text-cyan-300 text-sm mb-1 flex items-center gap-2\">\n              <span className=\"w-5 h-5 rounded-full bg-cyan-500/20 text-cyan-400 flex items-center justify-center text-xs\">2</span>\n              <span>Tri-Source Consensus & Carbon Math (45 seconds)</span>\n            </div>\n            <p className=\"text-slate-300 leading-relaxed pl-7\">\n              \"Watch as we select Pichavaram Mangrove Estuary and click <strong>\'Run MRV Consensus\'</strong>. The system doesn\'t rely on a single satellite photo. It cross-examines <strong>Sentinel-2 optical/SAR satellite data</strong>, <strong>drone RTK-LiDAR canopy heights</strong>, and <strong>in-situ IoT soil redox and carbon sensors</strong>. If the sources diverge by more than 14%, minting is blocked. When consensus passes, our engine applies IPCC Tier-3 Indian allometry and mints credits on our SHA-256 blockchain ledger.\"\n            </p>\n          </div>\n\n          <div className=\"p-4 rounded-xl bg-slate-950 border border-slate-800\">\n            <div className=\"font-bold text-amber-300 text-sm mb-1 flex items-center gap-2\">\n              <span className=\"w-5 h-5 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center text-xs\">3</span>\n              <span>The 80/20 Buffer Reserve Differentiator (45 seconds)</span>\n            </div>\n            <p className=\"text-slate-300 leading-relaxed pl-7\">\n              \"Notice the split: <strong>80% is minted as tradeable carbon credits, but 20% is held in a ring-fenced Buffer Reserve</strong>. Now let\'s simulate a Category-4 Super Cyclone hitting Sundarbans in our <strong>Buffer Reserve tab</strong>. The canopy suffers 38% defoliation. The next MRV audit detects a carbon loss of 11,700 tCO\342\202\202e. The platform <strong>instantly executes an automated Reversal Burn on the buffer pool</strong> \342\200\224 commercial credit buyers hold 100% solvent credits, and zero phantom carbon enters the Indian economy.\"\n            </p>\n          </div>\n\n          <div className=\"p-4 rounded-xl bg-slate-950 border border-slate-800\">\n            <div className=\"font-bold text-indigo-300 text-sm mb-1 flex items-center gap-2\">\n              <span className=\"w-5 h-5 rounded-full bg-indigo-500/20 text-indigo-400 flex items-center justify-center text-xs\">4</span>\n              <span>Tamper-Proof Blockchain Audit Trail (30 seconds)</span>\n            </div>\n            <p className=\"text-slate-300 leading-relaxed pl-7\">\n              \"Finally, let\'s open the <strong>Blockchain Ledger tab</strong>. We have an interactive demo button to simulate malicious database tampering. We modify Block #2 to artificially inflate the credit count. When we click <strong>\'Verify Ledger Integrity\'</strong>, our SHA-256 cryptographic recomputation flags the exact altered block in red. This provides immutable provenance for Indian state forest departments and global compliance buyers.\"\n            </p>\n          </div>\n\n        </div>\n      </div>\n\n      {/* Toucan Protocol Failure Case Study Comparison Table */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl\">\n        <h3 className=\"text-base font-bold text-white mb-2 flex items-center gap-2\">\n          <AlertTriangle className=\"w-4 h-4 text-amber-400\" />\n          <span>Case Study: Why Toucan Protocol Failed vs. How Our Architecture Solves It</span>\n        </h3>\n        <p className=\"text-xs text-slate-400 mb-4\">\n          Detailed comparative analysis against the 2021-22 tokenized carbon market breakdown\n        </p>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse\">\n            <thead>\n              <tr className=\"border-b border-slate-800 bg-slate-950 text-slate-400 uppercase text-[11px]\">\n                <th className=\"py-3 px-4\">Dimension</th>\n                <th className=\"py-3 px-4 text-red-400\">Legacy Web3 (Toucan / Base Carbon Pool)</th>\n                <th className=\"py-3 px-4 text-emerald-400\">Our Blue Carbon Registry (SIH26193)</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800 text-slate-300\">\n              \n              <tr>\n                <td className=\"py-3 px-4 font-semibold text-white\">Data Verification</td>\n                <td className=\"py-3 px-4 text-red-300\">\n                  Off-chain legacy PDFs from 2008-2015 without current physical MRV checks.\n                </td>\n                <td className=\"py-3 px-4 text-emerald-300 font-medium\">\n                  Continuous multi-source MRV consensus (Sentinel-2 Satellite + RTK Drone + IoT Soil Mesh).\n                </td>\n              </tr>\n\n              <tr>\n                <td className=\"py-3 px-4 font-semibold text-white\">Reversal & Disturbance Risk</td>\n                <td className=\"py-3 px-4 text-red-300\">\n                  Zero buffer mechanism. If a tokenized forest burned down, tokens remained circulating indefinitely (\"phantom carbon\").\n                </td>\n                <td className=\"py-3 px-4 text-emerald-300 font-medium\">\n                  Automated 80/20 Buffer Reserve. Ecological losses trigger immediate on-chain buffer compensation burns.\n                </td>\n              </tr>\n\n              <tr>\n                <td className=\"py-3 px-4 font-semibold text-white\">Consensus & Fraud Prevention</td>\n                <td className=\"py-3 px-4 text-red-300\">\n                  Permissionless tokenization bridge allowed dormant/junk credits to be dumped onto liquidity pools.\n                </td>\n                <td className=\"py-3 px-4 text-emerald-300 font-medium\">\n                  Byzantine cross-source tolerance check (max 14% delta threshold). Minting blocked on sensor anomalies.\n                </td>\n              </tr>\n\n              <tr>\n                <td className=\"py-3 px-4 font-semibold text-white\">India Allometric Calibration</td>\n                <td className=\"py-3 px-4 text-red-300\">\n                  Generic international rainforest defaults unsuited for estuarine wetlands.\n                </td>\n                <td className=\"py-3 px-4 text-emerald-300 font-medium\">\n                  Calibrated to FSI (Forest Survey of India) & IPCC Tier-3 Wetland Komiyama equations for Rhizophoraceae.\n                </td>\n              </tr>\n\n              <tr>\n                <td className=\"py-3 px-4 font-semibold text-white\">Ledger Auditability</td>\n                <td className=\"py-3 px-4 text-red-300\">\n                  Complex EVM contracts vulnerable to bridge exploits and high gas fees.\n                </td>\n                <td className=\"py-3 px-4 text-emerald-300 font-medium\">\n                  Zero-dependency cryptographic SHA-256 hash-linked audit chain with Merkle proofs and on-demand integrity verification.\n                </td>\n              </tr>\n\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n    </div>\n  );\n};\n"
    }
