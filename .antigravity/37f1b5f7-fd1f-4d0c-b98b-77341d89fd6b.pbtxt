          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        canopyHeightM: 4.8,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        stemDensityHa: 3100,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        crownClosurePct: 68.0,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        hyperspectralChlA: 28.5,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        surveyDate: \'2026-08-22T10:00:00Z\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        droneModel: \'DJI Mavic 3 Enterprise Thermal/RGB\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      groundSensors: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        socPercent30cm: 1.85,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        socPercent100cm: 1.15,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        soilBulkDensityGcm3: 1.18,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        salinityPsu: 42.0,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        redoxPotentialMv: -95,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        waterTableCm: 3.2,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        sedimentAccretionMmYr: 2.1,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        co2FluxGcm2Day: 2.65,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        activeNodeCount: 8,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        meshStatus: \'ONLINE\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "/**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " * Executes multi-source consensus check and calculates allometric carbon sequestration"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function runMRVConsensusCheck("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  site: MangroveSite,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  bufferRatioPct: number = 20,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  toleranceThresholdPct: number = 14"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "): ConsensusResult {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const { satellite, drone, groundSensors } = site.telemetry;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // 1. Satellite Estimation (Above Ground Biomass t/ha)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Calibrated to Indian Sentinel-2 NDVI + EVI + SAR backscatter"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const canopyFactor = (satellite.canopyAreaHa / site.totalAreaHa);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const satOpticalAGB = 165 * Math.pow(satellite.ndvi, 1.75) * (1 + satellite.evi * 0.25);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const sarCorrection = Math.max(0.85, Math.min(1.25, 1 + (satellite.sarBackscatterDb + 11) * 0.03));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const satelliteAGBEst = Number((satOpticalAGB * sarCorrection * canopyFactor).toFixed(2));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // 2. Drone LiDAR & High-Res Telemetry Estimation (Above Ground Biomass t/ha)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Komiyama / FSI Allometric Height & Crown equation: AGB = k * H * (Crown/100) * (Density factor)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const densityFactor = Math.min(1.2, drone.stemDensityHa / 1800);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const droneAGBEst = Number((9.8 * drone.canopyHeightM * (drone.crownClosurePct / 100) * densityFactor).toFixed(2));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // 3. Ground IoT Station Biomass & Soil Organic Carbon (SOC) Estimation (t/ha equivalent)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // SOC in top 100cm + flux chamber rate integration"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const soc30 = groundSensors.socPercent30cm * groundSensors.soilBulkDensityGcm3 * 30; // t C/ha top 30cm"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const soc70 = groundSensors.socPercent100cm * (groundSensors.soilBulkDensityGcm3 * 1.05) * 70; // t C/ha deep 70cm"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const totalSoilC = soc30 + soc70;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Convert root + soil carbon trajectory to equivalent annual AGB benchmark"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const groundSOCEst = Number(((totalSoilC * 0.85) + (groundSensors.co2FluxGcm2Day * 3.65 * 4.5)).toFixed(2));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Cross-source variance calculations"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const meanAGB = (satelliteAGBEst + droneAGBEst + groundSOCEst) / 3;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const deltaSatDrone = Math.abs(satelliteAGBEst - droneAGBEst) / meanAGB * 100;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const deltaDroneGround = Math.abs(droneAGBEst - groundSOCEst) / meanAGB * 100;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const deltaGroundSat = Math.abs(groundSOCEst - satelliteAGBEst) / meanAGB * 100;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const maxVariance = Math.max(deltaSatDrone, deltaDroneGround, deltaGroundSat);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const variancePct = Number(maxVariance.toFixed(2));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const anomalyFlags: string[] = [];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (satellite.cloudCoverPct > 15) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    anomalyFlags.push(`Satellite cloud cover (${satellite.cloudCoverPct}%) exceeds optimal threshold; optical NDVI may have higher uncertainty.`);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (groundSensors.meshStatus !== \'ONLINE\') {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    anomalyFlags.push(`Ground IoT mesh is reporting ${groundSensors.meshStatus}; partial node coverage.`);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (deltaSatDrone > toleranceThresholdPct) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    anomalyFlags.push(`Satellite-to-Drone variance (${deltaSatDrone.toFixed(1)}%) exceeds ${toleranceThresholdPct}% tolerance threshold.`);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (deltaDroneGround > toleranceThresholdPct) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    anomalyFlags.push(`Drone-to-Ground variance (${deltaDroneGround.toFixed(1)}%) exceeds ${toleranceThresholdPct}% tolerance threshold.`);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const passed = variancePct <= toleranceThresholdPct;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const confidenceScore = Number(Math.max(70, Math.min(99.4, 100 - (variancePct * 1.35))).toFixed(1));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // IPCC Wetland Supplement Tier-3 Allometric Carbon Sequestration Math"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Gross biomass: AGB + Below-ground Root Biomass (BGB = 0.49 * AGB)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const reconciledBiomassPerHa = meanAGB;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const bgbPerHa = reconciledBiomassPerHa * 0.49;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const totalBiomassPerHa = reconciledBiomassPerHa + bgbPerHa;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const carbonTonsPerHa = totalBiomassPerHa * 0.47; // Carbon fraction of biomass ~47%"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Net annual sequestration increment rate (calibrated by health score and baseline)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const annualIncrementFactor = 0.048 * (site.healthScore / 100) * (groundSensors.co2FluxGcm2Day / 4.5);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const netCarbonSequesteredTonsHa = carbonTonsPerHa * annualIncrementFactor;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Convert Carbon to CO2 equivalent: 1 tC = (44/12) tCO2e = 3.667 tCO2e"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const grossTCO2e = netCarbonSequesteredTonsHa * 3.6667 * site.totalAreaHa;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Apply 5% FSI conservative uncertainty discount"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const netTCO2e = Math.max(0, grossTCO2e * 0.95);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const reconciledAnnualSequestrationTCO2e = Math.round(netTCO2e);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Buffer Reserve Split (default 80% Tradeable / 20% Reserve)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const bufferReserveCredits = Math.round(reconciledAnnualSequestrationTCO2e * (bufferRatioPct / 100));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const tradeableCredits = reconciledAnnualSequestrationTCO2e - bufferReserveCredits;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const summary = passed"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ? `Consensus verified across Sentinel-2 Satellite, RTK-LiDAR Drone, and ${groundSensors.activeNodeCount} in-situ IoT nodes with ${confidenceScore}% confidence. Max inter-source variance was ${variancePct}%, well below the ${toleranceThresholdPct}% tolerance ceiling. Total verified carbon sequestration for ${site.name} is ${reconciledAnnualSequestrationTCO2e.toLocaleString()} tCO\342\202\202e (${tradeableCredits.toLocaleString()} tradeable credits, ${bufferReserveCredits.toLocaleString()} allocated to permanent buffer reserve).`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    : `Consensus failed: Inter-source variance reached ${variancePct}%, which exceeds the ${toleranceThresholdPct}% tolerance limit. Carbon credit minting blocked until sensors are re-calibrated or drone survey is re-run.`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    passed,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    confidenceScore,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    variancePct,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    satelliteAGBEst,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    droneAGBEst,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    groundSOCEst,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    grossBiomassTonsHa: Number(reconciledBiomassPerHa.toFixed(1)),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    reconciledAnnualSequestrationTCO2e,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tradeableCredits,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    bufferReserveCredits,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    bufferRatioPct,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    toleranceThresholdPct,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    sourceAgreement: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      satelliteVsDroneDeltaPct: Number(deltaSatDrone.toFixed(2)),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      droneVsGroundDeltaPct: Number(deltaDroneGround.toFixed(2)),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      groundVsSatelliteDeltaPct: Number(deltaGroundSat.toFixed(2))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    anomalyFlags,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    summary,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    methodology: \'India-FSI Tier-3 Wetland Blue Carbon Consensus Framework (SIH-26193)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    allometricEquation: \'AGB = 0.0509 * \317\201 * (DBH)\302\262 * H_lidar | BGB = 0.49 * AGB | SOC = \316\243(depth * bulk_density * SOC%)\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
