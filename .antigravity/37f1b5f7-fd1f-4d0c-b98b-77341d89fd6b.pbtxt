    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { MangroveSite } from \'../types\';\nimport { SiteCard } from \'./SiteCard\';\nimport { IndiaMapView } from \'./IndiaMapView\';\nimport { Map, Grid, Filter, Sparkles, Layers, ShieldAlert, CheckCircle2 } from \'lucide-react\';\n\ninterface SitesViewProps {\n  sites: MangroveSite[];\n  onVerifySite: (site: MangroveSite) => void;\n  onDegradeSite: (site: MangroveSite) => void;\n}\n\nexport const SitesView: React.FC<SitesViewProps> = ({\n  sites,\n  onVerifySite,\n  onDegradeSite\n}) => {\n  const [selectedState, setSelectedState] = useState<string>(\'ALL\');\n  const [selectedSiteId, setSelectedSiteId] = useState<string>(sites[0]?.id || \'sundarbans-01\');\n  const [viewMode, setViewMode] = useState<\'GRID\' | \'MAP_AND_GRID\'>(\'MAP_AND_GRID\');\n\n  const states = [\'ALL\', ...Array.from(new Set(sites.map(s => s.state)))];\n\n  const filteredSites = sites.filter(site => {\n    if (selectedState === \'ALL\') return true;\n    return site.state === selectedState;\n  });\n\n  const selectedSite = sites.find(s => s.id === selectedSiteId) || sites[0];\n\n  return (\n    <div className=\"space-y-6\">\n      \n      {/* Top Controls Bar */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-col md:flex-row md:items-center justify-between gap-4 shadow-lg\">\n        \n        {/* State Filter Chips */}\n        <div className=\"flex items-center gap-1.5 overflow-x-auto text-xs no-scrollbar\">\n          <span className=\"text-slate-400 font-semibold uppercase text-[11px] mr-1 hidden sm:inline\">\n            Region:\n          </span>\n          {states.map(state => (\n            <button\n              key={state}\n              onClick={() => setSelectedState(state)}\n              className={`px-3 py-1.5 rounded-lg font-medium transition-colors cursor-pointer whitespace-nowrap ${\n                selectedState === state\n                  ? \'bg-emerald-600 text-white shadow-sm\'\n                  : \'bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white\'\n              }`}\n            >\n              {state === \'ALL\' ? \'All Indian Regions\' : state}\n            </button>\n          ))}\n        </div>\n\n        {/* View Mode Toggle */}\n        <div className=\"flex items-center gap-1 bg-slate-950 p-1 rounded-lg border border-slate-800 text-xs\">\n          <button\n            onClick={() => setViewMode(\'MAP_AND_GRID\')}\n            className={`flex items-center gap-1.5 px-3 py-1 rounded-md transition-colors cursor-pointer ${\n              viewMode === \'MAP_AND_GRID\'\n                ? \'bg-slate-800 text-white font-medium\'\n                : \'text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            <Map className=\"w-3.5 h-3.5\" />\n            <span>Spatial Grid</span>\n          </button>\n\n          <button\n            onClick={() => setViewMode(\'GRID\')}\n            className={`flex items-center gap-1.5 px-3 py-1 rounded-md transition-colors cursor-pointer ${\n              viewMode === \'GRID\'\n                ? \'bg-slate-800 text-white font-medium\'\n                : \'text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            <Grid className=\"w-3.5 h-3.5\" />\n            <span>Cards Only</span>\n          </button>\n        </div>\n\n      </div>\n\n      {/* Spatial Map View if enabled */}\n      {viewMode === \'MAP_AND_GRID\' && (\n        <IndiaMapView\n          sites={filteredSites}\n          selectedSiteId={selectedSiteId}\n          onSelectSite={(site) => setSelectedSiteId(site.id)}\n          onVerifySite={onVerifySite}\n        />\n      )}\n\n      {/* Site Cards Grid */}\n      <div>\n        <div className=\"flex items-center justify-between mb-4\">\n          <h2 className=\"text-base font-bold text-white tracking-tight flex items-center gap-2\">\n            <Layers className=\"w-4 h-4 text-emerald-400\" />\n            <span>Monitored Indian Mangrove Wetlands ({filteredSites.length} Zones)</span>\n          </h2>\n          <span className=\"text-xs text-slate-400\">\n            Tri-source consensus verified every 30 days\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n          {filteredSites.map(site => (\n            <SiteCard\n              key={site.id}\n              site={site}\n              onVerify={onVerifySite}\n              onDegrade={onDegradeSite}\n              onSelect={(s) => setSelectedSiteId(s.id)}\n              isSelected={selectedSiteId === site.id}\n            />\n          ))}\n        </div>\n      </div>\n\n    </div>\n  );\n};\n"
    }
