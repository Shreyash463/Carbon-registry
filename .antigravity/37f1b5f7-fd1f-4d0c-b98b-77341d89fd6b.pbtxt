        }
        lines {
          text: "            </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            <p className=\"text-slate-300 leading-relaxed pl-7\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"Watch as we select Pichavaram Mangrove Estuary and click <strong>\'Run MRV Consensus\'</strong>. The system doesn\'t rely on a single satellite photo. It cross-examines <strong>Sentinel-2 optical/SAR satellite data</strong>, <strong>drone RTK-LiDAR canopy heights</strong>, and <strong>in-situ IoT soil redox and carbon sensors</strong>. If the sources diverge by more than 14%, minting is blocked. When consensus passes, our engine applies IPCC Tier-3 Indian allometry and mints credits on our SHA-256 blockchain ledger.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            </p>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
