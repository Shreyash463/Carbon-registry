  file_change {
    absolute_path_uri: "file:///src/components/MRVVerificationModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { MangroveSite, ConsensusResult, LedgerBlock, CarbonCredit } from \'../types\';\nimport { \n  CheckCircle2, \n  AlertTriangle, \n  X, \n  Satellite, \n  Plane, \n  Radio, \n  ShieldCheck, \n  Coins, \n  Sparkles, \n  RefreshCw, \n  Layers, \n  Calculator,\n  ArrowRight,\n  ShieldAlert,\n  Bot\n} from \'lucide-react\';\nimport confetti from \'canvas-confetti\';\n\ninterface MRVVerificationModalProps {\n  site: MangroveSite | null;\n  isOpen: boolean;\n  onClose: () => void;\n  onVerificationComplete: (result: {\n    site: MangroveSite;\n    consensus: ConsensusResult;\n    mintBlock: LedgerBlock;\n    newCredits: CarbonCredit[];\n  }) => void;\n}\n\nexport const MRVVerificationModal: React.FC<MRVVerificationModalProps> = ({\n  site,\n  isOpen,\n  onClose,\n  onVerificationComplete\n}) => {\n  const [bufferRatioPct, setBufferRatioPct] = useState(20);\n  const [isRunning, setIsRunning] = useState(false);\n  const [currentStep, setCurrentStep] = useState(0);\n  const [verificationData, setVerificationData] = useState<{\n    site: MangroveSite;\n    consensus: ConsensusResult;\n    mintBlock: LedgerBlock;\n    newCredits: CarbonCredit[];\n    isAiGenerated?: boolean;\n  } | null>(null);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n\n  useEffect(() => {\n    if (isOpen) {\n      setVerificationData(null);\n      setErrorMsg(null);\n      setCurrentStep(0);\n      setIsRunning(false);\n    }\n  }, [isOpen, site]);\n\n  if (!isOpen || !site) return null;\n\n  const handleStartVerification = async () => {\n    setIsRunning(true);\n    setErrorMsg(null);\n    setCurrentStep(1);\n\n    try {\n      // Step 1: Ingesting Telemetry\n      await new Promise(r => setTimeout(r, 600));\n      setCurrentStep(2);\n\n      // Step 2: Cross-Source Tolerance Matrix\n      await new Promise(r => setTimeout(r, 700));\n      setCurrentStep(3);\n\n      // Step 3: Carbon Sequestration Math\n      await new Promise(r => setTimeout(r, 700));\n      setCurrentStep(4);\n\n      // Step 4 & 5: Server Verification & Ledger Minting\n      const response = await fetch(\'/api/mrv/verify\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          siteId: site.id,\n          bufferRatioPct\n        })\n      });\n\n      const data = await response.json();\n      if (!response.ok || !data.success) {\n        throw new Error(data.error || \'MRV verification failed.\');\n      }\n\n      setCurrentStep(5);\n      await new Promise(r => setTimeout(r, 500));\n\n      setVerificationData({\n        site: data.site,\n        consensus: data.consensus,\n        mintBlock: data.mintBlock,\n        newCredits: data.newCredits,\n        isAiGenerated: data.isAiGenerated\n      });\n\n      // Confetti effect for successful minting\n      try {\n        confetti({\n          particleCount: 80,\n          spread: 60,\n          origin: { y: 0.6 }\n        });\n      } catch (e) {\n        // ignore if canvas is unavailable\n      }\n\n      onVerificationComplete({\n        site: data.site,\n        consensus: data.consensus,\n        mintBlock: data.mintBlock,\n        newCredits: data.newCredits\n      });\n    } catch (err: any) {\n      setErrorMsg(err.message || \'Verification failed\');\n    } finally {\n      setIsRunning(false);\n    }\n  };\n\n  const steps = [\n    { title: \'Telemetry Ingestion\', desc: \'Pulling Sentinel-2 optical/SAR, RTK-LiDAR, and in-situ IoT flux nodes\' },\n    { title: \'Consensus Tolerance Matrix\', desc: \'Evaluating cross-source variance against 14% allowable threshold\' },\n    { title: \'India-FSI Tier-3 Sequestration\', desc: \'Executing Komiyama allometric equations (AGB + BGB + SOC pool)\' },\n    { title: \'Cryptographic Proof & Merkle\', desc: \'Building SHA-256 Merkle root and Gov. of India validator signature\' },\n    { title: \'80/20 Ledger Minting\', desc: \'Allocating tradeable credits and ring-fencing 20% buffer reserve\' }\n  ];\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm overflow-y-auto\">\n      <div className=\"bg-slate-900 border border-slate-700 rounded-2xl w-full max-w-3xl overflow-hidden shadow-2xl my-8\">\n        \n        {/* Modal Header */}\n        <div className=\"px-6 py-4 border-b border-slate-800 flex items-center justify-between bg-slate-950/60\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400\">\n              <Sparkles className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h2 className=\"text-base font-bold text-white tracking-tight\">\n                Tri-Source MRV Consensus Audit\n              </h2>\n              <p className=\"text-xs text-slate-400\">\n                {site.name} \342\200\242 {site.totalAreaHa.toLocaleString()} Ha \342\200\242 {site.state}\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Body */}\n        <div className=\"p-6 space-y-6\">\n          \n          {/* If NOT completed yet: show configuration & pipeline */}\n          {!verificationData ? (\n            <>\n              {/* Telemetry Snapshot */}\n              <div className=\"grid grid-cols-3 gap-3\">\n                <div className=\"p-3 rounded-xl bg-slate-950/80 border border-slate-800 text-xs\">\n                  <div className=\"flex items-center gap-1.5 text-cyan-400 font-semibold mb-1\">\n                    <Satellite className=\"w-3.5 h-3.5\" />\n                    <span>Sentinel-2 Satellite</span>\n                  </div>\n                  <div className=\"text-slate-300 font-mono text-sm font-bold\">NDVI {site.telemetry.satellite.ndvi}</div>\n                  <div className=\"text-slate-400 text-[11px] mt-0.5\">Canopy: {site.telemetry.satellite.canopyAreaHa} Ha</div>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-slate-950/80 border border-slate-800 text-xs\">\n                  <div className=\"flex items-center gap-1.5 text-emerald-400 font-semibold mb-1\">\n                    <Plane className=\"w-3.5 h-3.5\" />\n                    <span>Drone RTK-LiDAR</span>\n                  </div>\n                  <div className=\"text-slate-300 font-mono text-sm font-bold\">{site.telemetry.drone.canopyHeightM}m Height</div>\n                  <div className=\"text-slate-400 text-[11px] mt-0.5\">Crown: {site.telemetry.drone.crownClosurePct}%</div>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-slate-950/80 border border-slate-800 text-xs\">\n                  <div className=\"flex items-center gap-1.5 text-amber-400 font-semibold mb-1\">\n                    <Radio className=\"w-3.5 h-3.5\" />\n                    <span>Ground IoT Mesh</span>\n                  </div>\n                  <div className=\"text-slate-300 font-mono text-sm font-bold\">{site.telemetry.groundSensors.socPercent30cm}% SOC</div>\n                  <div className=\"text-slate-400 text-[11px] mt-0.5\">{site.telemetry.groundSensors.activeNodeCount} Nodes Active</div>\n                </div>\n              </div>\n\n              {/* Buffer Reserve Configurator */}\n              <div className=\"p-4 rounded-xl bg-emerald-950/20 border border-emerald-900/40\">\n                <div className=\"flex items-center justify-between mb-2\">\n                  <div className=\"flex items-center gap-2\">\n                    <ShieldAlert className=\"w-4 h-4 text-amber-400\" />\n                    <span className=\"text-xs font-semibold text-slate-200 uppercase tracking-wide\">\n                      Risk Buffer Reserve Allocation Ratio\n                    </span>\n                  </div>\n                  <span className=\"text-xs font-bold text-amber-300 px-2 py-0.5 rounded bg-amber-950 border border-amber-800\">\n                    {bufferRatioPct}% Reserve / {100 - bufferRatioPct}% Tradeable\n                  </span>\n                </div>\n                <p className=\"text-xs text-slate-400 mb-3\">\n                  A non-tradeable buffer pool ring-fenced to absorb future cyclone, fire, or degradation shocks without causing credit market insolvency.\n                </p>\n                <div className=\"flex items-center gap-4\">\n                  <input\n                    type=\"range\"\n                    min=\"10\"\n                    max=\"40\"\n                    step=\"5\"\n                    value={bufferRatioPct}\n                    onChange={(e) => setBufferRatioPct(Number(e.target.value))}\n                    disabled={isRunning}\n                    className=\"w-full accent-emerald-500 cursor-pointer\"\n                  />\n                </div>\n              </div>\n\n              {/* Pipeline Step Progress */}\n              {isRunning && (\n                <div className=\"space-y-3 pt-2\">\n                  <h4 className=\"text-xs font-semibold text-slate-300 uppercase tracking-wide\">\n                    Executing Consensus Pipeline\n                  </h4>\n                  <div className=\"space-y-2\">\n                    {steps.map((step, idx) => {\n                      const stepNum = idx + 1;\n                      const isPast = currentStep > stepNum;\n                      const isCurrent = currentStep === stepNum;\n\n                      return (\n                        <div\n                          key={idx}\n                          className={`p-3 rounded-lg border text-xs flex items-center justify-between transition-colors ${\n                            isCurrent\n                              ? \'bg-slate-800/90 border-emerald-500/70 text-white\'\n                              : isPast\n                                ? \'bg-slate-950/60 border-emerald-800/40 text-slate-300\'\n                                : \'bg-slate-950/30 border-slate-800/50 text-slate-400\'\n                          }`}\n                        >\n                          <div className=\"flex items-center gap-3\">\n                            <div className={`w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold ${\n                              isPast \n                                ? \'bg-emerald-500 text-slate-950\' \n                                : isCurrent \n                                  ? \'bg-emerald-500/20 text-emerald-300 border border-emerald-500\' \n                                  : \'bg-slate-800 text-slate-500\'\n                            }`}>\n                              {isPast ? <CheckCircle2 className=\"w-3.5 h-3.5\" /> : stepNum}\n                            </div>\n                            <div>\n                              <div className=\"font-semibold\">{step.title}</div>\n                              <div className=\"text-[11px] text-slate-400\">{step.desc}</div>\n                            </div>\n                          </div>\n                          {isCurrent && (\n                            <RefreshCw className=\"w-4 h-4 animate-spin text-emerald-400\" />\n                          )}\n                        </div>\n                      );\n                    })}\n                  </div>\n                </div>\n              )}\n\n              {errorMsg && (\n                <div className=\"p-3 rounded-lg bg-red-950/60 border border-red-800 text-xs text-red-300 flex items-center gap-2\">\n                  <AlertTriangle className=\"w-4 h-4 text-red-400 shrink-0\" />\n                  <span>{errorMsg}</span>\n                </div>\n              )}\n            </>\n          ) : (\n            /* Successful MRV Verification Outcome Screen */\n            <div className=\"space-y-5\">\n              \n              {/* Success Banner */}\n              <div className=\"p-4 rounded-xl bg-emerald-950/50 border border-emerald-600/60 flex items-start gap-3\">\n                <div className=\"w-9 h-9 rounded-full bg-emerald-500 text-slate-950 flex items-center justify-center shrink-0\">\n                  <CheckCircle2 className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <h3 className=\"text-base font-bold text-white tracking-tight\">\n                    Consensus Certified & Credits Minted!\n                  </h3>\n                  <p className=\"text-xs text-emerald-300 mt-0.5\">\n                    Multi-source verification confirmed with {verificationData.consensus.confidenceScore}% confidence. Max inter-source variance was {verificationData.consensus.variancePct}%.\n                  </p>\n                </div>\n              </div>\n\n              {/* Tonnage & Split Summary */}\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n                <div className=\"p-3.5 rounded-xl bg-slate-950 border border-slate-800\">\n                  <span className=\"text-[11px] text-slate-400 block uppercase font-medium\">Reconciled Sequestration</span>\n                  <div className=\"text-xl font-bold text-white mt-1\">\n                    {verificationData.consensus.reconciledAnnualSequestrationTCO2e.toLocaleString()} <span className=\"text-xs font-normal text-slate-400\">tCO\342\202\202e</span>\n                  </div>\n                  <span className=\"text-[11px] text-emerald-400\">IPCC Tier-3 Net Certified</span>\n                </div>\n\n                <div className=\"p-3.5 rounded-xl bg-slate-950 border border-emerald-900/60 bg-emerald-950/20\">\n                  <span className=\"text-[11px] text-emerald-400 block uppercase font-medium\">Tradeable Active Credits (80%)</span>\n                  <div className=\"text-xl font-bold text-emerald-300 mt-1\">\n                    {verificationData.consensus.tradeableCredits.toLocaleString()} <span className=\"text-xs font-normal text-emerald-500\">units</span>\n                  </div>\n                  <span className=\"text-[11px] text-slate-400\">Available on registry</span>\n                </div>\n\n                <div className=\"p-3.5 rounded-xl bg-slate-950 border border-amber-900/60 bg-amber-950/20\">\n                  <span className=\"text-[11px] text-amber-400 block uppercase font-medium\">Buffer Reserve Held (20%)</span>\n                  <div className=\"text-xl font-bold text-amber-300 mt-1\">\n                    {verificationData.consensus.bufferReserveCredits.toLocaleString()} <span className=\"text-xs font-normal text-amber-500\">units</span>\n                  </div>\n                  <span className=\"text-[11px] text-slate-400\">Ring-fenced against reversal</span>\n                </div>\n              </div>\n\n              {/* Plain-language AI / Auditor Summary */}\n              <div className=\"p-4 rounded-xl bg-slate-950/80 border border-slate-800\">\n                <div className=\"flex items-center justify-between gap-2 mb-2\">\n                  <span className=\"text-xs font-semibold uppercase tracking-wider text-slate-300 flex items-center gap-1.5\">\n                    <Bot className=\"w-4 h-4 text-emerald-400\" />\n                    <span>MRV Compliance & Ecological Statement</span>\n                  </span>\n                  <span className=\"text-[11px] font-mono text-emerald-400 px-2 py-0.5 rounded bg-emerald-950 border border-emerald-800\">\n                    {verificationData.isAiGenerated ? \'Gemini 3.7 Flash Grounded\' : \'Official FSI Auditor Baseline\'}\n                  </span>\n                </div>\n                <p className=\"text-xs text-slate-300 leading-relaxed\">\n                  {verificationData.consensus.aiGeneratedSummary || verificationData.consensus.summary}\n                </p>\n              </div>\n\n              {/* Cryptographic Proof Card */}\n              <div className=\"p-3 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono\">\n                <div className=\"flex items-center justify-between text-slate-400 mb-1.5\">\n                  <span className=\"text-[11px] uppercase tracking-wide\">Blockchain Mint Block #{verificationData.mintBlock.index}</span>\n                  <span className=\"text-emerald-400\">SHA-256 Validated</span>\n                </div>\n                <div className=\"text-slate-300 truncate\">\n                  Hash: <span className=\"text-emerald-400 font-bold\">{verificationData.mintBlock.hash}</span>\n                </div>\n                <div className=\"text-slate-400 truncate text-[11px] mt-0.5\">\n                  Prev: {verificationData.mintBlock.previousHash}\n                </div>\n                <div className=\"text-slate-400 truncate text-[11px] mt-0.5\">\n                  Merkle: {verificationData.mintBlock.merkleRoot}\n                </div>\n              </div>\n\n            </div>\n          )}\n\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"px-6 py-4 border-t border-slate-800 flex items-center justify-between bg-slate-950/60\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition-colors cursor-pointer\"\n          >\n            {verificationData ? \'Close\' : \'Cancel\'}\n          </button>\n\n          {!verificationData ? (\n            <button\n              onClick={handleStartVerification}\n              disabled={isRunning}\n              className=\"flex items-center gap-2 px-5 py-2.5 rounded-lg text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition-colors cursor-pointer disabled:opacity-50\"\n            >\n              {isRunning ? (\n                <>\n                  <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n                  <span>Processing Consensus...</span>\n                </>\n              ) : (\n                <>\n                  <Sparkles className=\"w-3.5 h-3.5\" />\n                  <span>Execute MRV & Mint Credits</span>\n                </>\n              )}\n            </button>\n          ) : (\n            <button\n              onClick={onClose}\n              className=\"flex items-center gap-2 px-5 py-2.5 rounded-lg text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition-colors cursor-pointer\"\n            >\n              <CheckCircle2 className=\"w-4 h-4\" />\n              <span>Done & Update Registry</span>\n            </button>\n          )}\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
