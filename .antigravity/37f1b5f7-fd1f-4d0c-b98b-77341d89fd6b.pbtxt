    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { RegistryStats } from \'../types\';\nimport { ShieldCheck, ShieldAlert, Sparkles, Flame, TreePine, Award } from \'lucide-react\';\n\ninterface StatsOverviewProps {\n  stats: RegistryStats;\n}\n\nexport const StatsOverview: React.FC<StatsOverviewProps> = ({ stats }) => {\n  return (\n    <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 mb-6\">\n      \n      {/* 1. Total Monitored Area */}\n      <div className=\"bg-slate-900/80 border border-slate-800 rounded-xl p-3.5 flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between text-slate-400 mb-1\">\n          <span className=\"text-xs font-medium uppercase tracking-wider\">Monitored Area</span>\n          <TreePine className=\"w-4 h-4 text-emerald-400\" />\n        </div>\n        <div>\n          <div className=\"text-xl font-bold text-white tracking-tight\">\n            {stats.totalHectaresMonitored.toLocaleString()} <span className=\"text-xs font-normal text-slate-400\">Ha</span>\n          </div>\n          <p className=\"text-[11px] text-slate-400 mt-0.5\">{stats.totalSites} Ecosystem Zones</p>\n        </div>\n      </div>\n\n      {/* 2. Total Verified Minted */}\n      <div className=\"bg-slate-900/80 border border-slate-800 rounded-xl p-3.5 flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between text-slate-400 mb-1\">\n          <span className=\"text-xs font-medium uppercase tracking-wider\">Total Minted</span>\n          <Sparkles className=\"w-4 h-4 text-cyan-400\" />\n        </div>\n        <div>\n          <div className=\"text-xl font-bold text-white tracking-tight\">\n            {stats.totalMintedAllTime.toLocaleString()} <span className=\"text-xs font-normal text-slate-400\">tCO\342\202\202e</span>\n          </div>\n          <p className=\"text-[11px] text-emerald-400 mt-0.5\">India FSI Tier-3 Calibrated</p>\n        </div>\n      </div>\n\n      {/* 3. Tradeable Active Pool (80%) */}\n      <div className=\"bg-slate-900/80 border border-slate-800 rounded-xl p-3.5 flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between text-slate-400 mb-1\">\n          <span className=\"text-xs font-medium uppercase tracking-wider\">Tradeable Pool</span>\n          <Award className=\"w-4 h-4 text-emerald-400\" />\n        </div>\n        <div>\n          <div className=\"text-xl font-bold text-emerald-400 tracking-tight\">\n            {stats.totalTradeableActive.toLocaleString()} <span className=\"text-xs font-normal text-emerald-600\">tCO\342\202\202e</span>\n          </div>\n          <p className=\"text-[11px] text-slate-400 mt-0.5\">80% Active Liquidity</p>\n        </div>\n      </div>\n\n      {/* 4. Buffer Reserve Pool (20% held back) */}\n      <div className=\"bg-slate-900/80 border border-emerald-900/40 rounded-xl p-3.5 flex flex-col justify-between bg-emerald-950/20\">\n        <div className=\"flex items-center justify-between text-emerald-300 mb-1\">\n          <span className=\"text-xs font-medium uppercase tracking-wider\">Buffer Reserve</span>\n          <ShieldAlert className=\"w-4 h-4 text-amber-400\" />\n        </div>\n        <div>\n          <div className=\"text-xl font-bold text-amber-300 tracking-tight\">\n            {stats.totalBufferHeld.toLocaleString()} <span className=\"text-xs font-normal text-amber-500\">tCO\342\202\202e</span>\n          </div>\n          <p className=\"text-[11px] text-slate-300 mt-0.5\">20% Non-Tradeable Hold</p>\n        </div>\n      </div>\n\n      {/* 5. Retired Offsets (Permanently Burned) */}\n      <div className=\"bg-slate-900/80 border border-slate-800 rounded-xl p-3.5 flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between text-slate-400 mb-1\">\n          <span className=\"text-xs font-medium uppercase tracking-wider\">Retired Offsets</span>\n          <ShieldCheck className=\"w-4 h-4 text-indigo-400\" />\n        </div>\n        <div>\n          <div className=\"text-xl font-bold text-indigo-300 tracking-tight\">\n            {stats.totalRetired.toLocaleString()} <span className=\"text-xs font-normal text-slate-400\">units</span>\n          </div>\n          <p className=\"text-[11px] text-slate-400 mt-0.5\">Claimed & Neutralized</p>\n        </div>\n      </div>\n\n      {/* 6. Reversal Compensation Burns */}\n      <div className=\"bg-slate-900/80 border border-slate-800 rounded-xl p-3.5 flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between text-slate-400 mb-1\">\n          <span className=\"text-xs font-medium uppercase tracking-wider\">Reversal Burns</span>\n          <Flame className=\"w-4 h-4 text-orange-400\" />\n        </div>\n        <div>\n          <div className=\"text-xl font-bold text-orange-400 tracking-tight\">\n            {stats.totalReversalBurned.toLocaleString()} <span className=\"text-xs font-normal text-slate-400\">units</span>\n          </div>\n          <p className=\"text-[11px] text-slate-400 mt-0.5\">Absorbed from Buffer Pool</p>\n        </div>\n      </div>\n\n    </div>\n  );\n};\n"
    }
