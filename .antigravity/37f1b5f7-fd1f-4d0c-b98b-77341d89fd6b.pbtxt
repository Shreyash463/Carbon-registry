      original_chunk {
        target_content: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Inter\', system-ui, -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, Oxygen, Ubuntu, Cantarell, \'Open Sans\', \'Helvetica Neue\', sans-serif;\n  }\n\n  code, pre, .font-mono {\n    font-family: \'JetBrains Mono\', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n  }\n}\n\n/* Custom minimal scrollbar */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: rgba(15, 23, 42, 0.6);\n}\n\n::-webkit-scrollbar-thumb {\n  background: rgba(51, 65, 85, 0.8);\n  border-radius: 9999px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: rgba(71, 85, 105, 1);\n}\n\n.no-scrollbar::-webkit-scrollbar {\n  display: none;\n}\n.no-scrollbar {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}"
        replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --bg-main: #05080A;\n    --panel-dark: #080D11;\n    --card-surface: #0B1218;\n    --card-inner: #0F171C;\n    --card-elevated: #161F27;\n    --border-dim: #1E293B;\n    --neon-green: #00FF9C;\n    --neon-cyan: #00D1FF;\n    --neon-amber: #FF8A00;\n    --neon-red: #FF4444;\n  }\n\n  body {\n    background-color: #05080A;\n    color: #E0E7EB;\n    font-family: \'Inter\', system-ui, -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, Oxygen, Ubuntu, Cantarell, \'Open Sans\', \'Helvetica Neue\', sans-serif;\n  }\n\n  code, pre, .font-mono {\n    font-family: \'JetBrains Mono\', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n  }\n}\n\n/* Custom Minimal Futuristic Scrollbar */\n::-webkit-scrollbar {\n  width: 5px;\n  height: 5px;\n}\n\n::-webkit-scrollbar-track {\n  background: #05080A;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #1E293B;\n  border-radius: 2px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #00FF9C55;\n}\n\n.no-scrollbar::-webkit-scrollbar {\n  display: none;\n}\n.no-scrollbar {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n\n/* Immersive UI Scanline and Grid Utilities */\n.bg-grid-pattern {\n  background-image: radial-gradient(#1E293B 1px, transparent 1px);\n  background-size: 20px 20px;\n}\n\n.glow-mint {\n  box-shadow: 0 0 15px rgba(0, 255, 156, 0.25);\n}\n\n.glow-cyan {\n  box-shadow: 0 0 15px rgba(0, 209, 255, 0.25);\n}\n\n.glow-amber {\n  box-shadow: 0 0 15px rgba(255, 138, 0, 0.25);\n}\n\n.glow-red {\n  box-shadow: 0 0 15px rgba(255, 68, 68, 0.25);\n}\n"
