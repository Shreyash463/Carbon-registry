    instruction: "Apply Immersive UI styling and high-contrast telemetry styling to BufferReserveView"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { MangroveSite, RegistryStats, LedgerBlock } from \'../types\';\nimport { \n  ShieldAlert, \n  ShieldCheck, \n  Flame, \n  Wind, \n  AlertTriangle, \n  TrendingDown, \n  Sparkles, \n  CheckCircle2,\n  RefreshCw,\n  Info,\n  Layers,\n  ArrowRight\n} from \'lucide-react\';\nimport confetti from \'canvas-confetti\';\n\ninterface BufferReserveViewProps {\n  sites: MangroveSite[];\n  stats: RegistryStats;\n  onTriggerReversal: (siteId: string, severity: \'MODERATE_SURGE\' | \'SEVERE_CYCLONE\') => Promise<void>;\n  isProcessingReversal: boolean;\n}\n\nexport const BufferReserveView: React.FC<BufferReserveViewProps> = ({\n  sites,\n  stats,\n  onTriggerReversal,\n  isProcessingReversal\n}) => {\n  const [selectedSiteId, setSelectedSiteId] = useState<string>(sites[0]?.id || \'sundarbans-01\');\n  const [severity, setSeverity] = useState<\'MODERATE_SURGE\' | \'SEVERE_CYCLONE\'>(\'SEVERE_CYCLONE\');\n  const [lastReversalOutcome, setLastReversalOutcome] = useState<{\n    siteName: string;\n    lossTons: number;\n    burnedCredits: number;\n    triggerEvent: string;\n  } | null>(null);\n\n  const selectedSite = sites.find(s => s.id === selectedSiteId) || sites[0];\n\n  const handleSimulateReversal = async () => {\n    try {\n      await onTriggerReversal(selectedSiteId, severity);\n      const estLoss = Math.round(selectedSite.totalAreaHa * (severity === \'SEVERE_CYCLONE\' ? 0.75 : 0.35) * 3.667);\n      setLastReversalOutcome({\n        siteName: selectedSite.name,\n        lossTons: estLoss,\n        burnedCredits: Math.min(selectedSite.activeBufferReserve, estLoss),\n        triggerEvent: severity === \'SEVERE_CYCLONE\' \n          ? \'Category-4 Super Cyclone Storm Surge & Canopy Defoliation\'\n          : \'High Salinity Estuarine Surge Stress\'\n      });\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const bufferRatio = stats.totalMintedAllTime > 0 \n    ? ((stats.totalBufferHeld / stats.totalMintedAllTime) * 100).toFixed(1)\n    : \'20.0\';\n\n  return (\n    <div className=\"space-y-6\">\n      \n      {/* Top Value Proposition & Mechanism Card */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl\">\n        <div className=\"flex items-center gap-2.5 text-xs font-bold text-amber-400 uppercase tracking-wider mb-2\">\n          <ShieldAlert className=\"w-4 h-4\" />\n          <span>Core Market Differentiator \342\200\242 Risk Buffer Reserve Safeguard</span>\n        </div>\n        <h2 className=\"text-xl font-bold text-white tracking-tight\">\n          Automated Reversal Compensation & Reserve Pool\n        </h2>\n        <p className=\"text-xs text-slate-300 mt-2 max-w-3xl leading-relaxed\">\n          Traditional carbon markets collapsed in 2021-22 when tokenized credits (e.g. Toucan Protocol) backed degraded or burned forests without any physical reserves. The <strong>Blue Carbon Registry</strong> solves this by ring-fencing <strong>20% of all minted credits into a non-tradeable buffer pool</strong>. When natural disasters (cyclones, tidal surges, or dieback) degrade a mangrove zone, the system automatically burns buffer credits on-chain to cover the exact carbon delta \342\200\224 <strong>keeping tradeable market credits 100% solvent.</strong>\n        </p>\n\n        {/* Live Safety Metrics Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4 mt-6 pt-6 border-t border-slate-800\">\n          \n          <div className=\"p-4 bg-slate-950/80 rounded-xl border border-amber-900/40\">\n            <span className=\"text-[11px] text-amber-400 font-semibold uppercase block\">Ring-Fenced Buffer Pool</span>\n            <div className=\"text-2xl font-bold text-amber-300 mt-1\">\n              {stats.totalBufferHeld.toLocaleString()} <span className=\"text-xs font-normal text-amber-500\">tCO\342\202\202e</span>\n            </div>\n            <span className=\"text-[11px] text-slate-400 mt-1 block\">Current Buffer Ratio: {bufferRatio}%</span>\n          </div>\n\n          <div className=\"p-4 bg-slate-950/80 rounded-xl border border-slate-800\">\n            <span className=\"text-[11px] text-emerald-400 font-semibold uppercase block\">Active Tradeable Pool</span>\n            <div className=\"text-2xl font-bold text-emerald-300 mt-1\">\n              {stats.totalTradeableActive.toLocaleString()} <span className=\"text-xs font-normal text-emerald-600\">tCO\342\202\202e</span>\n            </div>\n            <span className=\"text-[11px] text-slate-400 mt-1 block\">100% Backed & Insured</span>\n          </div>\n\n          <div className=\"p-4 bg-slate-950/80 rounded-xl border border-slate-800\">\n            <span className=\"text-[11px] text-orange-400 font-semibold uppercase block\">Total Reversal Absorbed</span>\n            <div className=\"text-2xl font-bold text-orange-400 mt-1\">\n              {stats.totalReversalBurned.toLocaleString()} <span className=\"text-xs font-normal text-slate-400\">units</span>\n            </div>\n            <span className=\"text-[11px] text-slate-400 mt-1 block\">Compensated by Buffer Burns</span>\n          </div>\n\n          <div className=\"p-4 bg-slate-950/80 rounded-xl border border-emerald-900/40 bg-emerald-950/20\">\n            <span className=\"text-[11px] text-emerald-400 font-semibold uppercase block\">Registry Solvency Score</span>\n            <div className=\"text-2xl font-bold text-white mt-1\">\n              100.0%\n            </div>\n            <span className=\"text-[11px] text-emerald-400 mt-1 block\">Zero Phantom Credit Exposure</span>\n          </div>\n\n        </div>\n      </div>\n\n      {/* Interactive Reversal Trigger Sandbox */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl\">\n        <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-800\">\n          <div>\n            <h3 className=\"text-base font-bold text-white flex items-center gap-2\">\n              <Wind className=\"w-4 h-4 text-red-400\" />\n              <span>Live Reversal Trigger Simulator (Judge Demo Sandbox)</span>\n            </h3>\n            <p className=\"text-xs text-slate-400 mt-0.5\">\n              Simulate an extreme weather event on an Indian mangrove zone to watch the automated buffer compensation execution.\n            </p>\n          </div>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 mt-6\">\n          \n          {/* Controls column */}\n          <div className=\"lg:col-span-6 space-y-4\">\n            \n            {/* 1. Select Site */}\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5\">\n                Target Mangrove Ecosystem Zone\n              </label>\n              <select\n                value={selectedSiteId}\n                onChange={(e) => setSelectedSiteId(e.target.value)}\n                className=\"w-full bg-slate-950 border border-slate-700 text-xs text-white rounded-lg p-2.5 focus:outline-none focus:border-red-500 cursor-pointer\"\n              >\n                {sites.map(s => (\n                  <option key={s.id} value={s.id}>\n                    {s.name} ({s.state}) \342\200\242 {s.activeBufferReserve.toLocaleString()} t Buffer Held\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            {/* 2. Select Disturbance Severity */}\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5\">\n                Disturbance Severity & Scenario\n              </label>\n              <div className=\"grid grid-cols-2 gap-3\">\n                <button\n                  type=\"button\"\n                  onClick={() => setSeverity(\'SEVERE_CYCLONE\')}\n                  className={`p-3 rounded-xl border text-left cursor-pointer transition-all ${\n                    severity === \'SEVERE_CYCLONE\'\n                      ? \'bg-red-950/80 border-red-500 text-white\'\n                      : \'bg-slate-950 border-slate-800 text-slate-400 hover:border-slate-700\'\n                  }`}\n                >\n                  <div className=\"font-bold text-xs text-red-400 mb-1 flex items-center gap-1.5\">\n                    <Wind className=\"w-3.5 h-3.5\" />\n                    <span>Category-4 Cyclone</span>\n                  </div>\n                  <div className=\"text-[11px] text-slate-300\">\n                    38% Canopy Defoliation & Storm Surge Erosion\n                  </div>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => setSeverity(\'MODERATE_SURGE\')}\n                  className={`p-3 rounded-xl border text-left cursor-pointer transition-all ${\n                    severity === \'MODERATE_SURGE\'\n                      ? \'bg-amber-950/80 border-amber-500 text-white\'\n                      : \'bg-slate-950 border-slate-800 text-slate-400 hover:border-slate-700\'\n                  }`}\n                >\n                  <div className=\"font-bold text-xs text-amber-400 mb-1 flex items-center gap-1.5\">\n                    <TrendingDown className=\"w-3.5 h-3.5\" />\n                    <span>Tidal Dieback Surge</span>\n                  </div>\n                  <div className=\"text-[11px] text-slate-300\">\n                    20% Estuarine Salinity Stress & Loss\n                  </div>\n                </button>\n              </div>\n            </div>\n\n            {/* Launch Simulation Button */}\n            <button\n              onClick={handleSimulateReversal}\n              disabled={isProcessingReversal}\n              className=\"w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-xs font-bold bg-red-600 hover:bg-red-500 text-white transition-colors cursor-pointer disabled:opacity-50 shadow-lg shadow-red-950/60\"\n            >\n              {isProcessingReversal ? (\n                <>\n                  <RefreshCw className=\"w-4 h-4 animate-spin\" />\n                  <span>Processing Ecological Loss & Burning Buffer...</span>\n                </>\n              ) : (\n                <>\n                  <Flame className=\"w-4 h-4\" />\n                  <span>Trigger Disturbance & Execute On-Chain Buffer Burn</span>\n                </>\n              )}\n            </button>\n\n          </div>\n\n          {/* Visualization / Output Column */}\n          <div className=\"lg:col-span-6 bg-slate-950 rounded-xl border border-slate-800 p-5 flex flex-col justify-between\">\n            <div>\n              <span className=\"text-[11px] font-semibold text-slate-400 uppercase tracking-wider block mb-2\">\n                Real-Time Reversal Compensation Flow\n              </span>\n\n              {lastReversalOutcome ? (\n                <div className=\"space-y-3\">\n                  <div className=\"p-3.5 rounded-lg bg-red-950/60 border border-red-800/80 text-xs\">\n                    <div className=\"flex items-center gap-2 text-red-400 font-bold mb-1\">\n                      <AlertTriangle className=\"w-4 h-4\" />\n                      <span>Ecological Disturbance Detected</span>\n                    </div>\n                    <p className=\"text-slate-300 text-[11px] leading-relaxed\">\n                      {lastReversalOutcome.triggerEvent} at <strong>{lastReversalOutcome.siteName}</strong> caused an estimated biomass loss of <strong>{lastReversalOutcome.lossTons.toLocaleString()} tCO\342\202\202e</strong>.\n                    </p>\n                  </div>\n\n                  <div className=\"p-3.5 rounded-lg bg-emerald-950/40 border border-emerald-800 text-xs\">\n                    <div className=\"flex items-center gap-2 text-emerald-400 font-bold mb-1\">\n                      <CheckCircle2 className=\"w-4 h-4\" />\n                      <span>Buffer Reserve Automatically Compensated</span>\n                    </div>\n                    <p className=\"text-slate-300 text-[11px] leading-relaxed\">\n                      <strong>{lastReversalOutcome.burnedCredits.toLocaleString()} Buffer Reserve units</strong> were permanently burned on the blockchain ledger (Block Type: <span className=\"font-mono text-red-300 font-bold\">BUFFER_REVERSAL_BURN</span>).\n                    </p>\n                  </div>\n\n                  <div className=\"p-3 bg-slate-900 rounded-lg border border-slate-800 text-[11px] text-slate-400\">\n                    <span className=\"text-slate-300 font-semibold\">Market Impact Result:</span> Commercial buyers holding tradeable carbon credits experienced <strong>0% devaluation</strong>. The loss was 100% absorbed by the ring-fenced reserve pool.\n                  </div>\n                </div>\n              ) : (\n                <div className=\"space-y-3 text-xs text-slate-400\">\n                  <div className=\"p-3 bg-slate-900/60 rounded-lg border border-slate-800\">\n                    <span className=\"font-semibold text-slate-300 block mb-1\">1. Continuous MRV Monitoring</span>\n                    Tri-source telemetry compares current NDVI, LiDAR canopy height, and soil flux against the previous verified baseline.\n                  </div>\n                  <div className=\"p-3 bg-slate-900/60 rounded-lg border border-slate-800\">\n                    <span className=\"font-semibold text-slate-300 block mb-1\">2. Negative Biomass Delta Calculation</span>\n                    If canopy loss exceeds the 5% natural fluctuation band, the carbon deficit is measured using India-FSI allometry.\n                  </div>\n                  <div className=\"p-3 bg-slate-900/60 rounded-lg border border-slate-800\">\n                    <span className=\"font-semibold text-slate-300 block mb-1\">3. Automated On-Chain Burn</span>\n                    Corresponding buffer tokens are burned immediately on the ledger, preserving market integrity without external bailouts.\n                  </div>\n                </div>\n              )}\n            </div>\n\n            <div className=\"pt-3 border-t border-slate-800/80 text-[11px] text-slate-400 flex items-center justify-between\">\n              <span>Smart Contract Autonomy</span>\n              <span className=\"text-emerald-400 font-mono\">Consensus-Guaranteed</span>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* Per-Site Buffer Reserve Allocation Table */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl\">\n        <h3 className=\"text-base font-bold text-white mb-3\">\n          Regional Mangrove Buffer Allocations\n        </h3>\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse\">\n            <thead>\n              <tr className=\"border-b border-slate-800 text-slate-400 font-semibold uppercase text-[11px]\">\n                <th className=\"py-2.5 px-3\">Ecosystem Zone</th>\n                <th className=\"py-2.5 px-3\">State</th>\n                <th className=\"py-2.5 px-3\">Monitored Area</th>\n                <th className=\"py-2.5 px-3\">Total Minted</th>\n                <th className=\"py-2.5 px-3\">Active Buffer Reserve (20%)</th>\n                <th className=\"py-2.5 px-3\">Status</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/60\">\n              {sites.map(site => (\n                <tr key={site.id} className=\"hover:bg-slate-800/40\">\n                  <td className=\"py-2.5 px-3 font-semibold text-white\">{site.name}</td>\n                  <td className=\"py-2.5 px-3 text-slate-400\">{site.state}</td>\n                  <td className=\"py-2.5 px-3 text-slate-300\">{site.totalAreaHa.toLocaleString()} Ha</td>\n                  <td className=\"py-2.5 px-3 font-semibold text-cyan-400\">{site.totalCreditsMinted.toLocaleString()} tCO\342\202\202e</td>\n                  <td className=\"py-2.5 px-3 font-bold text-amber-400\">{site.activeBufferReserve.toLocaleString()} tCO\342\202\202e</td>\n                  <td className=\"py-2.5 px-3\">\n                    <span className={`px-2 py-0.5 rounded-full text-[10px] font-bold ${\n                      site.verificationStatus === \'DEGRADED_ALERT\' \n                        ? \'bg-red-950 text-red-300 border border-red-700\' \n                        : \'bg-emerald-950 text-emerald-300 border border-emerald-700\'\n                    }`}>\n                      {site.verificationStatus}\n                    </span>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport { MangroveSite, RegistryStats, LedgerBlock } from \'../types\';\nimport { \n  ShieldAlert, \n  ShieldCheck, \n  Flame, \n  Wind, \n  AlertTriangle, \n  TrendingDown, \n  Sparkles, \n  CheckCircle2,\n  RefreshCw,\n  Info,\n  Layers,\n  ArrowRight,\n  Cpu\n} from \'lucide-react\';\nimport confetti from \'canvas-confetti\';\n\ninterface BufferReserveViewProps {\n  sites: MangroveSite[];\n  stats: RegistryStats;\n  onTriggerReversal: (siteId: string, severity: \'MODERATE_SURGE\' | \'SEVERE_CYCLONE\') => Promise<void>;\n  isProcessingReversal: boolean;\n}\n\nexport const BufferReserveView: React.FC<BufferReserveViewProps> = ({\n  sites,\n  stats,\n  onTriggerReversal,\n  isProcessingReversal\n}) => {\n  const [selectedSiteId, setSelectedSiteId] = useState<string>(sites[0]?.id || \'sundarbans-01\');\n  const [severity, setSeverity] = useState<\'MODERATE_SURGE\' | \'SEVERE_CYCLONE\'>(\'SEVERE_CYCLONE\');\n  const [lastReversalOutcome, setLastReversalOutcome] = useState<{\n    siteName: string;\n    lossTons: number;\n    burnedCredits: number;\n    triggerEvent: string;\n  } | null>(null);\n\n  const selectedSite = sites.find(s => s.id === selectedSiteId) || sites[0];\n\n  const handleSimulateReversal = async () => {\n    try {\n      await onTriggerReversal(selectedSiteId, severity);\n      const estLoss = Math.round(selectedSite.totalAreaHa * (severity === \'SEVERE_CYCLONE\' ? 0.75 : 0.35) * 3.667);\n      setLastReversalOutcome({\n        siteName: selectedSite.name,\n        lossTons: estLoss,\n        burnedCredits: Math.min(selectedSite.activeBufferReserve, estLoss),\n        triggerEvent: severity === \'SEVERE_CYCLONE\' \n          ? \'Category-4 Super Cyclone Storm Surge & Canopy Defoliation\'\n          : \'High Salinity Estuarine Surge Stress\'\n      });\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const bufferRatio = stats.totalMintedAllTime > 0 \n    ? ((stats.totalBufferHeld / stats.totalMintedAllTime) * 100).toFixed(1)\n    : \'20.0\';\n\n  return (\n    <div className=\"space-y-6\">\n      \n      {/* Top Value Proposition & Mechanism Card */}\n      <div className=\"bg-[#080D11] border border-[#1E293B] rounded-lg p-6\">\n        <div className=\"flex items-center gap-2 text-xs font-mono font-bold text-[#FF8A00] uppercase tracking-[0.2em] mb-2\">\n          <ShieldAlert className=\"w-4 h-4\" />\n          <span>Core Market Differentiator \342\200\242 Risk Buffer Reserve Safeguard</span>\n        </div>\n        <h2 className=\"text-xl font-bold font-mono text-white tracking-tight uppercase\">\n          Automated Reversal Compensation & Solvency Pool\n        </h2>\n        <p className=\"text-xs font-mono text-[#94A3B8] mt-2 max-w-3xl leading-relaxed\">\n          Traditional carbon registries collapsed in 2021-22 when tokenized credits backed degraded or burned forests without liquid reserves. The <strong>Blue Carbon Registry</strong> solves this by ring-fencing <strong>20% of all minted credits into a smart-contract buffer pool</strong>. When extreme weather degrades a sector, buffer credits are automatically burned on-chain to cover the exact carbon delta \342\200\224 <strong>keeping tradeable market credits 100% solvent.</strong>\n        </p>\n\n        {/* Live Safety Metrics Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4 mt-6 pt-6 border-t border-[#1E293B]\">\n          \n          <div className=\"p-4 bg-[#05080A] rounded border border-[#FF8A00]/40\">\n            <span className=\"text-[10px] font-mono text-[#FF8A00] uppercase tracking-widest block\">Ring-Fenced Buffer Pool</span>\n            <div className=\"text-2xl font-bold font-mono text-[#FF8A00] mt-1\">\n              {stats.totalBufferHeld.toLocaleString()} <span className=\"text-xs font-normal text-[#94A3B8]\">tCO\342\202\202e</span>\n            </div>\n            <span className=\"text-[10px] font-mono text-[#64748B] mt-1 block\">Buffer Ratio: {bufferRatio}%</span>\n          </div>\n\n          <div className=\"p-4 bg-[#05080A] rounded border border-[#1E293B]\">\n            <span className=\"text-[10px] font-mono text-[#00FF9C] uppercase tracking-widest block\">Active Tradeable Pool</span>\n            <div className=\"text-2xl font-bold font-mono text-[#00FF9C] mt-1\">\n              {stats.totalTradeableActive.toLocaleString()} <span className=\"text-xs font-normal text-[#94A3B8]\">tCO\342\202\202e</span>\n            </div>\n            <span className=\"text-[10px] font-mono text-[#64748B] mt-1 block\">100% Insured & Collateralized</span>\n          </div>\n\n          <div className=\"p-4 bg-[#05080A] rounded border border-[#1E293B]\">\n            <span className=\"text-[10px] font-mono text-[#00D1FF] uppercase tracking-widest block\">Total Reversals Absorbed</span>\n            <div className=\"text-2xl font-bold font-mono text-[#00D1FF] mt-1\">\n              {stats.totalReversalBurned.toLocaleString()} <span className=\"text-xs font-normal text-[#94A3B8]\">units</span>\n            </div>\n            <span className=\"text-[10px] font-mono text-[#64748B] mt-1 block\">Compensated by Buffer Burns</span>\n          </div>\n\n          <div className=\"p-4 bg-[#05080A] rounded border border-[#00FF9C]/40\">\n            <span className=\"text-[10px] font-mono text-[#00FF9C] uppercase tracking-widest block\">Registry Solvency Score</span>\n            <div className=\"text-2xl font-bold font-mono text-white mt-1\">\n              100.0%\n            </div>\n            <span className=\"text-[10px] font-mono text-[#00FF9C] mt-1 block\">Zero Phantom Credit Exposure</span>\n          </div>\n\n        </div>\n      </div>\n\n      {/* Interactive Reversal Trigger Sandbox */}\n      <div className=\"bg-[#080D11] border border-[#1E293B] rounded-lg p-6\">\n        <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-[#1E293B]\">\n          <div>\n            <h3 className=\"text-sm font-bold font-mono text-white uppercase tracking-wider flex items-center gap-2\">\n              <Wind className=\"w-4 h-4 text-[#FF4444]\" />\n              <span>Live Reversal Trigger Simulator (Judge Demo Sandbox)</span>\n            </h3>\n            <p className=\"text-xs font-mono text-[#64748B] mt-0.5\">\n              Simulate an extreme weather event on an Indian mangrove zone to watch the automated buffer compensation execution.\n            </p>\n          </div>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 mt-6\">\n          \n          {/* Controls column */}\n          <div className=\"lg:col-span-6 space-y-4\">\n            \n            {/* 1. Select Site */}\n            <div>\n              <label className=\"block text-xs font-mono uppercase tracking-wider text-[#94A3B8] mb-1.5\">\n                Target Mangrove Fleet Sector\n              </label>\n              <select\n                value={selectedSiteId}\n                onChange={(e) => setSelectedSiteId(e.target.value)}\n                className=\"w-full bg-[#05080A] border border-[#1E293B] text-xs font-mono text-white rounded p-2.5 focus:outline-none focus:border-[#FF4444] cursor-pointer\"\n              >\n                {sites.map(s => (\n                  <option key={s.id} value={s.id}>\n                    {s.name} ({s.state}) \342\200\242 {s.activeBufferReserve.toLocaleString()} t Buffer Held\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            {/* 2. Select Disturbance Severity */}\n            <div>\n              <label className=\"block text-xs font-mono uppercase tracking-wider text-[#94A3B8] mb-1.5\">\n                Disturbance Severity & Scenario\n              </label>\n              <div className=\"grid grid-cols-2 gap-3\">\n                <button\n                  type=\"button\"\n                  onClick={() => setSeverity(\'SEVERE_CYCLONE\')}\n                  className={`p-3 rounded border text-left cursor-pointer transition-all font-mono ${\n                    severity === \'SEVERE_CYCLONE\'\n                      ? \'bg-[#FF4444]/15 border-[#FF4444] text-white shadow-[0_0_10px_rgba(255,68,68,0.2)]\'\n                      : \'bg-[#05080A] border-[#1E293B] text-[#64748B] hover:border-[#FF4444]/40\'\n                  }`}\n                >\n                  <div className=\"font-bold text-xs text-[#FF4444] mb-1 flex items-center gap-1.5 uppercase\">\n                    <Wind className=\"w-3.5 h-3.5\" />\n                    <span>Cat-4 Cyclone</span>\n                  </div>\n                  <div className=\"text-[10px] text-[#94A3B8]\">\n                    38% Canopy Defoliation & Storm Surge Erosion\n                  </div>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => setSeverity(\'MODERATE_SURGE\')}\n                  className={`p-3 rounded border text-left cursor-pointer transition-all font-mono ${\n                    severity === \'MODERATE_SURGE\'\n                      ? \'bg-[#FF8A00]/15 border-[#FF8A00] text-white shadow-[0_0_10px_rgba(255,138,0,0.2)]\'\n                      : \'bg-[#05080A] border-[#1E293B] text-[#64748B] hover:border-[#FF8A00]/40\'\n                  }`}\n                >\n                  <div className=\"font-bold text-xs text-[#FF8A00] mb-1 flex items-center gap-1.5 uppercase\">\n                    <TrendingDown className=\"w-3.5 h-3.5\" />\n                    <span>Tidal Surge Dieback</span>\n                  </div>\n                  <div className=\"text-[10px] text-[#94A3B8]\">\n                    20% Estuarine Salinity Stress & Loss\n                  </div>\n                </button>\n              </div>\n            </div>\n\n            {/* Launch Simulation Button */}\n            <button\n              onClick={handleSimulateReversal}\n              disabled={isProcessingReversal}\n              className=\"w-full flex items-center justify-center gap-2 py-3 px-4 rounded text-xs font-mono font-bold uppercase tracking-wider bg-[#FF4444]/20 hover:bg-[#FF4444]/30 text-[#FF4444] border border-[#FF4444]/60 transition-all cursor-pointer disabled:opacity-50 shadow-[0_0_15px_rgba(255,68,68,0.25)]\"\n            >\n              {isProcessingReversal ? (\n                <>\n                  <RefreshCw className=\"w-4 h-4 animate-spin\" />\n                  <span>BURNING BUFFER RESERVE ON LEDGER...</span>\n                </>\n              ) : (\n                <>\n                  <Flame className=\"w-4 h-4\" />\n                  <span>TRIGGER DISTURBANCE & EXECUTE ON-CHAIN BURN</span>\n                </>\n              )}\n            </button>\n\n          </div>\n\n          {/* Visualization / Output Column */}\n          <div className=\"lg:col-span-6 bg-[#05080A] rounded border border-[#1E293B] p-5 flex flex-col justify-between font-mono\">\n            <div>\n              <span className=\"text-[10px] font-bold text-[#64748B] uppercase tracking-widest block mb-3\">\n                Real-Time Reversal Compensation Flow\n              </span>\n\n              {lastReversalOutcome ? (\n                <div className=\"space-y-3\">\n                  <div className=\"p-3.5 rounded bg-[#FF4444]/15 border border-[#FF4444]/50 text-xs\">\n                    <div className=\"flex items-center gap-2 text-[#FF4444] font-bold mb-1 uppercase tracking-wider\">\n                      <AlertTriangle className=\"w-4 h-4\" />\n                      <span>Ecological Disturbance Detected</span>\n                    </div>\n                    <p className=\"text-[#E0E7EB] text-[11px] leading-relaxed\">\n                      {lastReversalOutcome.triggerEvent} at <strong>{lastReversalOutcome.siteName}</strong> caused an estimated biomass loss of <strong className=\"text-[#FF4444]\">{lastReversalOutcome.lossTons.toLocaleString()} tCO\342\202\202e</strong>.\n                    </p>\n                  </div>\n\n                  <div className=\"p-3.5 rounded bg-[#00FF9C]/10 border border-[#00FF9C]/40 text-xs\">\n                    <div className=\"flex items-center gap-2 text-[#00FF9C] font-bold mb-1 uppercase tracking-wider\">\n                      <CheckCircle2 className=\"w-4 h-4\" />\n                      <span>Buffer Reserve Automatically Compensated</span>\n                    </div>\n                    <p className=\"text-[#E0E7EB] text-[11px] leading-relaxed\">\n                      <strong className=\"text-[#00FF9C]\">{lastReversalOutcome.burnedCredits.toLocaleString()} Buffer Reserve units</strong> were permanently burned on the blockchain ledger (Block Type: <span className=\"text-[#FF4444] font-bold\">BUFFER_REVERSAL_BURN</span>).\n                    </p>\n                  </div>\n\n                  <div className=\"p-3 bg-[#080D11] rounded border border-[#1E293B] text-[11px] text-[#94A3B8]\">\n                    <span className=\"text-white font-bold uppercase\">Solvency Result:</span> Commercial buyers holding tradeable carbon credits experienced <strong>0% devaluation</strong>. The loss was 100% absorbed by the ring-fenced reserve pool.\n                  </div>\n                </div>\n              ) : (\n                <div className=\"space-y-3 text-xs text-[#64748B]\">\n                  <div className=\"p-3 bg-[#080D11] rounded border border-[#1E293B]\">\n                    <span className=\"font-bold text-white uppercase text-[10px] block mb-1\">1. Continuous MRV Monitoring</span>\n                    Tri-source telemetry compares current NDVI, LiDAR canopy height, and soil flux against the previous verified baseline.\n                  </div>\n                  <div className=\"p-3 bg-[#080D11] rounded border border-[#1E293B]\">\n                    <span className=\"font-bold text-white uppercase text-[10px] block mb-1\">2. Negative Biomass Delta Calculation</span>\n                    If canopy loss exceeds the 5% natural fluctuation band, the carbon deficit is measured using India-FSI allometry.\n                  </div>\n                  <div className=\"p-3 bg-[#080D11] rounded border border-[#1E293B]\">\n                    <span className=\"font-bold text-white uppercase text-[10px] block mb-1\">3. Automated On-Chain Burn</span>\n                    Corresponding buffer tokens are burned immediately on the ledger, preserving market integrity without external bailouts.\n                  </div>\n                </div>\n              )}\n            </div>\n\n            <div className=\"pt-3 border-t border-[#1E293B] text-[10px] text-[#64748B] flex items-center justify-between uppercase tracking-widest\">\n              <span>Smart Contract Execution</span>\n              <span className=\"text-[#00FF9C] font-bold\">Consensus-Guaranteed</span>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* Per-Site Buffer Reserve Allocation Table */}\n      <div className=\"bg-[#080D11] border border-[#1E293B] rounded-lg p-5\">\n        <h3 className=\"text-sm font-bold font-mono text-white mb-3 uppercase tracking-wider\">\n          Regional Mangrove Buffer Allocations\n        </h3>\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse font-mono\">\n            <thead>\n              <tr className=\"border-b border-[#1E293B] bg-[#05080A] text-[#64748B] font-semibold uppercase text-[10px] tracking-widest\">\n                <th className=\"py-2.5 px-3\">Ecosystem Zone</th>\n                <th className=\"py-2.5 px-3\">State</th>\n                <th className=\"py-2.5 px-3\">Monitored Area</th>\n                <th className=\"py-2.5 px-3\">Total Minted</th>\n                <th className=\"py-2.5 px-3\">Active Buffer (20%)</th>\n                <th className=\"py-2.5 px-3\">Status</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-[#1E293B]\">\n              {sites.map(site => (\n                <tr key={site.id} className=\"hover:bg-[#0F171C]/60\">\n                  <td className=\"py-2.5 px-3 font-bold text-white\">{site.name}</td>\n                  <td className=\"py-2.5 px-3 text-[#94A3B8]\">{site.state}</td>\n                  <td className=\"py-2.5 px-3 text-[#E0E7EB]\">{site.totalAreaHa.toLocaleString()} Ha</td>\n                  <td className=\"py-2.5 px-3 font-semibold text-[#00D1FF]\">{site.totalCreditsMinted.toLocaleString()} tCO\342\202\202e</td>\n                  <td className=\"py-2.5 px-3 font-bold text-[#FF8A00]\">{site.activeBufferReserve.toLocaleString()} tCO\342\202\202e</td>\n                  <td className=\"py-2.5 px-3\">\n                    <span className={`px-2 py-0.5 rounded text-[10px] font-bold ${\n                      site.verificationStatus === \'DEGRADED_ALERT\' \n                        ? \'bg-[#FF4444]/20 text-[#FF4444] border border-[#FF4444]/60\' \n                        : \'bg-[#00FF9C]/15 text-[#00FF9C] border border-[#00FF9C]/40\'\n                    }`}>\n                      {site.verificationStatus}\n                    </span>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n    </div>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
}
