        }
        lines {
          text: "              <span className=\"w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs\">1</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              <span>The Problem: The Toucan Protocol Failure (30 seconds)</span>"
