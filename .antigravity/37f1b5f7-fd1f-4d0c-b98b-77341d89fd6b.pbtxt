    instruction: "Update SiteCard component to Immersive UI design theme with cyan/mint telemetry metrics and high-tech command aesthetics"
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { MangroveSite } from \'../types\';\nimport { \n  Satellite, \n  Plane, \n  Radio, \n  Play, \n  AlertTriangle, \n  MapPin, \n  TreePine, \n  ShieldCheck,\n  Zap,\n  Activity,\n  Wind\n} from \'lucide-react\';\n\ninterface SiteCardProps {\n  site: MangroveSite;\n  onVerify: (site: MangroveSite) => void;\n  onDegrade: (site: MangroveSite) => void;\n  onSelect: (site: MangroveSite) => void;\n  isSelected?: boolean;\n}\n\nexport const SiteCard: React.FC<SiteCardProps> = ({\n  site,\n  onVerify,\n  onDegrade,\n  onSelect,\n  isSelected\n}) => {\n  const getStatusBadge = (status: MangroveSite[\'verificationStatus\']) => {\n    switch (status) {\n      case \'VERIFIED\':\n        return (\n          <span className=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-950/90 text-emerald-300 border border-emerald-700\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\"></span>\n            Verified & Minted\n          </span>\n        );\n      case \'PENDING_MRV\':\n        return (\n          <span className=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-950/90 text-amber-300 border border-amber-700\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-amber-400\"></span>\n            MRV Audit Ready\n          </span>\n        );\n      case \'DEGRADED_ALERT\':\n        return (\n          <span className=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-950/90 text-red-300 border border-red-700 animate-pulse\">\n            <AlertTriangle className=\"w-3 h-3 text-red-400\" />\n            Reversal Event (Degraded)\n          </span>\n        );\n      case \'ANOMALY_FLAGGED\':\n        return (\n          <span className=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-purple-950/90 text-purple-300 border border-purple-700\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-purple-400\"></span>\n            Consensus Discrepancy\n          </span>\n        );\n    }\n  };\n\n  const getHealthColor = (score: number) => {\n    if (score >= 90) return \'text-emerald-400\';\n    if (score >= 75) return \'text-lime-400\';\n    if (score >= 55) return \'text-amber-400\';\n    return \'text-red-400\';\n  };\n\n  return (\n    <div \n      className={`bg-slate-900 border rounded-xl overflow-hidden transition-all flex flex-col justify-between ${\n        isSelected \n          ? \'border-emerald-500 ring-1 ring-emerald-500/50 shadow-lg shadow-emerald-950/30\' \n          : \'border-slate-800 hover:border-slate-700\'\n      }`}\n    >\n      {/* Header */}\n      <div className=\"p-4 border-b border-slate-800/80\">\n        <div className=\"flex items-start justify-between gap-2 mb-2\">\n          <div>\n            <div className=\"flex items-center gap-1.5 text-xs text-slate-400 mb-1\">\n              <MapPin className=\"w-3.5 h-3.5 text-emerald-400\" />\n              <span>{site.state}, India</span>\n              <span className=\"text-slate-600\">\342\200\242</span>\n              <span>{site.ecosystemType}</span>\n            </div>\n            <h3 className=\"text-base font-bold text-white tracking-tight leading-snug\">\n              {site.name}\n            </h3>\n          </div>\n          <div>{getStatusBadge(site.verificationStatus)}</div>\n        </div>\n\n        {/* Primary metrics summary */}\n        <div className=\"grid grid-cols-3 gap-2 mt-3 pt-2.5 border-t border-slate-800/60 text-xs\">\n          <div>\n            <span className=\"text-slate-400 block text-[11px]\">Area</span>\n            <span className=\"font-semibold text-slate-200\">{site.totalAreaHa.toLocaleString()} Ha</span>\n          </div>\n          <div>\n            <span className=\"text-slate-400 block text-[11px]\">Health Index</span>\n            <span className={`font-bold ${getHealthColor(site.healthScore)}`}>\n              {site.healthScore}/100\n            </span>\n          </div>\n          <div>\n            <span className=\"text-slate-400 block text-[11px]\">Total Minted</span>\n            <span className=\"font-semibold text-emerald-400\">\n              {site.totalCreditsMinted > 0 ? `${site.totalCreditsMinted.toLocaleString()} t` : \'0 t\'}\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* 3 Independent Data Source Feeds */}\n      <div className=\"p-4 bg-slate-950/40 space-y-3\">\n        <div className=\"text-[11px] font-semibold uppercase tracking-wider text-slate-400 flex items-center justify-between\">\n          <span>Tri-Source MRV Telemetry</span>\n          <span className=\"text-slate-400 font-normal\">All 3 Feeds Active</span>\n        </div>\n\n        {/* Source 1: Satellite */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-lg p-2.5 flex items-center justify-between text-xs\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-7 h-7 rounded bg-cyan-950 text-cyan-400 flex items-center justify-center border border-cyan-800/50\">\n              <Satellite className=\"w-3.5 h-3.5\" />\n            </div>\n            <div>\n              <div className=\"font-medium text-slate-200 flex items-center gap-1.5\">\n                <span>Satellite (Sentinel-2)</span>\n                <span className=\"text-[10px] text-cyan-400 font-mono\">NDVI {site.telemetry.satellite.ndvi}</span>\n              </div>\n              <div className=\"text-[11px] text-slate-400\">\n                SAR: {site.telemetry.satellite.sarBackscatterDb} dB | Canopy: {site.telemetry.satellite.canopyAreaHa} Ha\n              </div>\n            </div>\n          </div>\n          <div className=\"text-right\">\n            <span className=\"text-[10px] text-slate-400 block\">Cloud Cover</span>\n            <span className=\"font-semibold text-slate-300\">{site.telemetry.satellite.cloudCoverPct}%</span>\n          </div>\n        </div>\n\n        {/* Source 2: Drone */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-lg p-2.5 flex items-center justify-between text-xs\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-7 h-7 rounded bg-emerald-950 text-emerald-400 flex items-center justify-center border border-emerald-800/50\">\n              <Plane className=\"w-3.5 h-3.5\" />\n            </div>\n            <div>\n              <div className=\"font-medium text-slate-200 flex items-center gap-1.5\">\n                <span>Drone RTK-LiDAR</span>\n                <span className=\"text-[10px] text-emerald-400 font-mono\">H: {site.telemetry.drone.canopyHeightM}m</span>\n              </div>\n              <div className=\"text-[11px] text-slate-400\">\n                Crown: {site.telemetry.drone.crownClosurePct}% | {site.telemetry.drone.stemDensityHa} stems/Ha\n              </div>\n            </div>\n          </div>\n          <div className=\"text-right\">\n            <span className=\"text-[10px] text-slate-400 block\">Chl-a Index</span>\n            <span className=\"font-semibold text-slate-300\">{site.telemetry.drone.hyperspectralChlA}</span>\n          </div>\n        </div>\n\n        {/* Source 3: Ground IoT */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-lg p-2.5 flex items-center justify-between text-xs\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-7 h-7 rounded bg-amber-950 text-amber-400 flex items-center justify-center border border-amber-800/50\">\n              <Radio className=\"w-3.5 h-3.5\" />\n            </div>\n            <div>\n              <div className=\"font-medium text-slate-200 flex items-center gap-1.5\">\n                <span>Ground IoT Sensor Mesh</span>\n                <span className=\"text-[10px] text-amber-400 font-mono\">SOC {site.telemetry.groundSensors.socPercent30cm}%</span>\n              </div>\n              <div className=\"text-[11px] text-slate-400\">\n                Salinity: {site.telemetry.groundSensors.salinityPsu} PSU | Redox: {site.telemetry.groundSensors.redoxPotentialMv} mV\n              </div>\n            </div>\n          </div>\n          <div className=\"text-right\">\n            <span className=\"text-[10px] text-slate-400 block\">{site.telemetry.groundSensors.activeNodeCount} Nodes</span>\n            <span className=\"text-[10px] font-semibold text-emerald-400\">{site.telemetry.groundSensors.meshStatus}</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Dominant Species Tags */}\n      <div className=\"px-4 py-2 bg-slate-950/60 border-t border-slate-800/60 flex flex-wrap gap-1.5\">\n        {site.dominantSpecies.slice(0, 2).map((species, i) => (\n          <span key={i} className=\"text-[10px] italic px-2 py-0.5 rounded bg-slate-800 text-slate-300\">\n            {species}\n          </span>\n        ))}\n        {site.dominantSpecies.length > 2 && (\n          <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-400\">\n            +{site.dominantSpecies.length - 2} more\n          </span>\n        )}\n      </div>\n\n      {/* Action Footer */}\n      <div className=\"p-3 border-t border-slate-800 flex items-center gap-2\">\n        <button\n          onClick={() => onVerify(site)}\n          className=\"flex-1 flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition-colors cursor-pointer shadow-sm shadow-emerald-900/40\"\n        >\n          <Play className=\"w-3.5 h-3.5 fill-current\" />\n          <span>Run MRV Consensus</span>\n        </button>\n\n        <button\n          onClick={() => onDegrade(site)}\n          title=\"Simulate Category-4 Cyclone or severe defoliation to trigger automated Buffer Reserve Burn\"\n          className=\"flex items-center justify-center gap-1.5 py-2 px-2.5 rounded-lg text-xs font-medium bg-red-950/60 hover:bg-red-900/80 text-red-300 border border-red-800/70 transition-colors cursor-pointer\"\n        >\n          <Wind className=\"w-3.5 h-3.5 text-red-400\" />\n          <span className=\"hidden sm:inline\">Simulate Disturbance</span>\n          <span className=\"sm:hidden\">Cyclone</span>\n        </button>\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport { MangroveSite } from \'../types\';\nimport { \n  Satellite, \n  Plane, \n  Radio, \n  Play, \n  AlertTriangle, \n  MapPin, \n  TreePine, \n  ShieldCheck,\n  Zap,\n  Activity,\n  Wind\n} from \'lucide-react\';\n\ninterface SiteCardProps {\n  site: MangroveSite;\n  onVerify: (site: MangroveSite) => void;\n  onDegrade: (site: MangroveSite) => void;\n  onSelect: (site: MangroveSite) => void;\n  isSelected?: boolean;\n}\n\nexport const SiteCard: React.FC<SiteCardProps> = ({\n  site,\n  onVerify,\n  onDegrade,\n  onSelect,\n  isSelected\n}) => {\n  const getStatusBadge = (status: MangroveSite[\'verificationStatus\']) => {\n    switch (status) {\n      case \'VERIFIED\':\n        return (\n          <span className=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[#00FF9C]/15 text-[#00FF9C] border border-[#00FF9C]/40\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-[#00FF9C] shadow-[0_0_6px_#00FF9C] animate-pulse\"></span>\n            MINTED / ACTIVE\n          </span>\n        );\n      case \'PENDING_MRV\':\n        return (\n          <span className=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[#00D1FF]/15 text-[#00D1FF] border border-[#00D1FF]/40\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-[#00D1FF]\"></span>\n            MRV READY\n          </span>\n        );\n      case \'DEGRADED_ALERT\':\n        return (\n          <span className=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[#FF4444]/20 text-[#FF4444] border border-[#FF4444]/60 animate-pulse\">\n            <AlertTriangle className=\"w-3 h-3 text-[#FF4444]\" />\n            DISTURBANCE ALERT\n          </span>\n        );\n      case \'ANOMALY_FLAGGED\':\n        return (\n          <span className=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[#FF8A00]/20 text-[#FF8A00] border border-[#FF8A00]/60\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-[#FF8A00]\"></span>\n            ANOMALY DELTA\n          </span>\n        );\n    }\n  };\n\n  const getHealthColor = (score: number) => {\n    if (score >= 90) return \'text-[#00FF9C]\';\n    if (score >= 75) return \'text-[#00D1FF]\';\n    if (score >= 55) return \'text-[#FF8A00]\';\n    return \'text-[#FF4444]\';\n  };\n\n  return (\n    <div \n      onClick={() => onSelect(site)}\n      className={`bg-[#080D11] border rounded-lg overflow-hidden transition-all flex flex-col justify-between cursor-pointer ${\n        isSelected \n          ? \'border-l-4 border-l-[#00FF9C] border-[#00FF9C]/50 shadow-[0_0_20px_rgba(0,255,156,0.15)] bg-[#0B1218]\' \n          : \'border-[#1E293B] hover:border-[#1E293B]/80 hover:bg-[#0B1218]\'\n      }`}\n    >\n      {/* Header */}\n      <div className=\"p-4 border-b border-[#1E293B]\">\n        <div className=\"flex items-start justify-between gap-2 mb-2\">\n          <div>\n            <div className=\"flex items-center gap-1.5 text-[11px] font-mono text-[#64748B] uppercase tracking-wider mb-1\">\n              <MapPin className=\"w-3.5 h-3.5 text-[#00FF9C]\" />\n              <span>{site.state}, IN</span>\n              <span className=\"text-[#1E293B]\">|</span>\n              <span className=\"text-[#94A3B8]\">{site.ecosystemType}</span>\n            </div>\n            <h3 className=\"text-base font-bold text-white tracking-tight uppercase\">\n              {site.name}\n            </h3>\n          </div>\n          <div>{getStatusBadge(site.verificationStatus)}</div>\n        </div>\n\n        {/* Primary metrics summary */}\n        <div className=\"grid grid-cols-3 gap-2 mt-3 pt-2.5 border-t border-[#1E293B] text-xs font-mono\">\n          <div>\n            <span className=\"text-[#64748B] block text-[10px] uppercase tracking-widest\">Monitored</span>\n            <span className=\"font-bold text-white\">{site.totalAreaHa.toLocaleString()} Ha</span>\n          </div>\n          <div>\n            <span className=\"text-[#64748B] block text-[10px] uppercase tracking-widest\">Health</span>\n            <span className={`font-bold ${getHealthColor(site.healthScore)}`}>\n              {site.healthScore}/100\n            </span>\n          </div>\n          <div>\n            <span className=\"text-[#64748B] block text-[10px] uppercase tracking-widest\">Minted Pool</span>\n            <span className=\"font-bold text-[#00FF9C]\">\n              {site.totalCreditsMinted > 0 ? `${site.totalCreditsMinted.toLocaleString()} t` : \'0.0 t\'}\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* 3 Independent Data Source Feeds */}\n      <div className=\"p-3.5 bg-[#05080A]/60 space-y-2\">\n        <div className=\"text-[10px] font-mono uppercase tracking-[0.2em] text-[#64748B] flex items-center justify-between\">\n          <span>Tri-Source MRV Telemetry</span>\n          <span className=\"text-[#00FF9C] text-[9px] flex items-center gap-1\">\n            <span className=\"w-1 h-1 rounded-full bg-[#00FF9C]\"></span>\n            SYNCED\n          </span>\n        </div>\n\n        {/* Source 1: Satellite */}\n        <div className=\"bg-[#0F171C] border border-[#1E293B] rounded p-2 flex items-center justify-between text-xs font-mono\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-6 h-6 rounded bg-[#00D1FF]/10 text-[#00D1FF] flex items-center justify-center border border-[#00D1FF]/30 shrink-0\">\n              <Satellite className=\"w-3 h-3\" />\n            </div>\n            <div>\n              <div className=\"text-[#E0E7EB] text-[11px] font-semibold flex items-center gap-1.5\">\n                <span>Sentinel-2 SAR</span>\n                <span className=\"text-[10px] text-[#00D1FF]\">NDVI {site.telemetry.satellite.ndvi}</span>\n              </div>\n              <div className=\"text-[10px] text-[#64748B]\">\n                SAR: {site.telemetry.satellite.sarBackscatterDb} dB | {site.telemetry.satellite.canopyAreaHa} Ha\n              </div>\n            </div>\n          </div>\n          <div className=\"text-right shrink-0\">\n            <span className=\"text-[9px] text-[#64748B] uppercase block\">Cloud</span>\n            <span className=\"text-[11px] text-white\">{site.telemetry.satellite.cloudCoverPct}%</span>\n          </div>\n        </div>\n\n        {/* Source 2: Drone */}\n        <div className=\"bg-[#0F171C] border border-[#1E293B] rounded p-2 flex items-center justify-between text-xs font-mono\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-6 h-6 rounded bg-[#00FF9C]/10 text-[#00FF9C] flex items-center justify-center border border-[#00FF9C]/30 shrink-0\">\n              <Plane className=\"w-3 h-3\" />\n            </div>\n            <div>\n              <div className=\"text-[#E0E7EB] text-[11px] font-semibold flex items-center gap-1.5\">\n                <span>RTK-LiDAR Drone</span>\n                <span className=\"text-[10px] text-[#00FF9C]\">H: {site.telemetry.drone.canopyHeightM}m</span>\n              </div>\n              <div className=\"text-[10px] text-[#64748B]\">\n                Crown: {site.telemetry.drone.crownClosurePct}% | {site.telemetry.drone.stemDensityHa} stems/Ha\n              </div>\n            </div>\n          </div>\n          <div className=\"text-right shrink-0\">\n            <span className=\"text-[9px] text-[#64748B] uppercase block\">Chl-a</span>\n            <span className=\"text-[11px] text-white\">{site.telemetry.drone.hyperspectralChlA}</span>\n          </div>\n        </div>\n\n        {/* Source 3: Ground IoT */}\n        <div className=\"bg-[#0F171C] border border-[#1E293B] rounded p-2 flex items-center justify-between text-xs font-mono\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-6 h-6 rounded bg-[#FF8A00]/10 text-[#FF8A00] flex items-center justify-center border border-[#FF8A00]/30 shrink-0\">\n              <Radio className=\"w-3 h-3\" />\n            </div>\n            <div>\n              <div className=\"text-[#E0E7EB] text-[11px] font-semibold flex items-center gap-1.5\">\n                <span>IoT Mesh Sensor</span>\n                <span className=\"text-[10px] text-[#FF8A00]\">SOC {site.telemetry.groundSensors.socPercent30cm}%</span>\n              </div>\n              <div className=\"text-[10px] text-[#64748B]\">\n                Salinity: {site.telemetry.groundSensors.salinityPsu} PSU | {site.telemetry.groundSensors.redoxPotentialMv} mV\n              </div>\n            </div>\n          </div>\n          <div className=\"text-right shrink-0\">\n            <span className=\"text-[9px] text-[#64748B] uppercase block\">{site.telemetry.groundSensors.activeNodeCount} Nodes</span>\n            <span className=\"text-[10px] text-[#00FF9C] font-bold\">{site.telemetry.groundSensors.meshStatus}</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Dominant Species Tags */}\n      <div className=\"px-3.5 py-2 bg-[#080D11] border-t border-[#1E293B] flex flex-wrap gap-1.5\">\n        {site.dominantSpecies.slice(0, 2).map((species, i) => (\n          <span key={i} className=\"text-[10px] font-mono italic px-2 py-0.5 rounded bg-[#0F171C] border border-[#1E293B] text-[#94A3B8]\">\n            {species}\n          </span>\n        ))}\n        {site.dominantSpecies.length > 2 && (\n          <span className=\"text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#0F171C] text-[#64748B]\">\n            +{site.dominantSpecies.length - 2}\n          </span>\n        )}\n      </div>\n\n      {/* Action Footer */}\n      <div className=\"p-3 border-t border-[#1E293B] flex items-center gap-2 bg-[#080D11]\">\n        <button\n          onClick={(e) => {\n            e.stopPropagation();\n            onVerify(site);\n          }}\n          className=\"flex-1 flex items-center justify-center gap-1.5 py-2.5 px-3 rounded bg-[#00FF9C] hover:bg-[#00D1FF] text-[#05080A] text-xs font-bold font-mono tracking-widest uppercase transition-all cursor-pointer shadow-[0_0_12px_rgba(0,255,156,0.2)]\"\n        >\n          <Play className=\"w-3 h-3 fill-current\" />\n          <span>RUN MRV CONSENSUS</span>\n        </button>\n\n        <button\n          onClick={(e) => {\n            e.stopPropagation();\n            onDegrade(site);\n          }}\n          title=\"Simulate Category-4 Cyclone or severe defoliation to trigger automated Buffer Reserve Burn\"\n          className=\"flex items-center justify-center gap-1.5 py-2.5 px-2.5 rounded bg-[#FF4444]/15 hover:bg-[#FF4444]/25 text-[#FF4444] border border-[#FF4444]/40 text-xs font-mono font-semibold uppercase transition-all cursor-pointer\"\n        >\n          <Wind className=\"w-3.5 h-3.5 text-[#FF4444]\" />\n          <span className=\"hidden sm:inline\">CYCLONE SIM</span>\n        </button>\n      </div>\n    </div>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
}
