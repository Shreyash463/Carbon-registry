    instruction: "Apply Immersive UI cyber styling to CertificateModal"
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { CarbonCredit } from \'../types\';\nimport { Award, CheckCircle2, ShieldCheck, Download, X, Printer, TreePine } from \'lucide-react\';\n\ninterface CertificateModalProps {\n  credit: CarbonCredit | null;\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const CertificateModal: React.FC<CertificateModalProps> = ({\n  credit,\n  isOpen,\n  onClose\n}) => {\n  if (!isOpen || !credit || !credit.retiredDetails) return null;\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/85 backdrop-blur-sm overflow-y-auto\">\n      <div className=\"bg-slate-900 border border-slate-700 rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl my-8 text-white\">\n        \n        {/* Top Control Bar */}\n        <div className=\"px-6 py-3 border-b border-slate-800 flex items-center justify-between bg-slate-950/70\">\n          <div className=\"flex items-center gap-2 text-xs font-semibold text-emerald-400 uppercase tracking-wider\">\n            <ShieldCheck className=\"w-4 h-4\" />\n            <span>Official Government of India MRV Offset Proof</span>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={handlePrint}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors cursor-pointer\"\n            >\n              <Printer className=\"w-3.5 h-3.5\" />\n              <span>Print / PDF</span>\n            </button>\n            <button\n              onClick={onClose}\n              className=\"p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors cursor-pointer\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Certificate Ornamental Content */}\n        <div className=\"p-8 bg-gradient-to-b from-slate-900 via-slate-950 to-slate-900 border-8 border-slate-950 m-4 rounded-xl relative\">\n          \n          {/* Subtle Background Emblem */}\n          <div className=\"absolute inset-0 flex items-center justify-center opacity-5 pointer-events-none\">\n            <TreePine className=\"w-80 h-80 text-emerald-500\" />\n          </div>\n\n          <div className=\"relative text-center space-y-4\">\n            \n            {/* Header / Seal */}\n            <div className=\"flex flex-col items-center justify-center\">\n              <div className=\"w-14 h-14 rounded-full bg-emerald-500/10 border-2 border-emerald-500/40 flex items-center justify-center text-emerald-400 mb-2\">\n                <Award className=\"w-8 h-8\" />\n              </div>\n              <span className=\"text-[11px] font-bold uppercase tracking-widest text-emerald-400\">\n                National Blue Carbon Registry of India\n              </span>\n              <h2 className=\"text-2xl font-serif font-bold text-white tracking-tight mt-1\">\n                Certificate of Carbon Retirement\n              </h2>\n              <div className=\"text-xs font-mono text-slate-400 mt-1\">\n                Certificate ID: <span className=\"text-emerald-400 font-bold\">{credit.retiredDetails.certificateNumber}</span>\n              </div>\n            </div>\n\n            <div className=\"w-24 h-0.5 bg-emerald-500/40 mx-auto my-2\"></div>\n\n            {/* Main Statement */}\n            <p className=\"text-xs text-slate-300 max-w-lg mx-auto leading-relaxed\">\n              This document certifies the permanent on-chain retirement and environmental extinguishment of <strong className=\"text-white\">1.0 Metric Ton of CO\342\202\202 Equivalent (tCO\342\202\202e)</strong> sequestered in pristine Indian coastal mangrove wetlands.\n            </p>\n\n            {/* Beneficiary Highlight Box */}\n            <div className=\"p-4 rounded-xl bg-slate-900/90 border border-slate-800 max-w-md mx-auto text-center\">\n              <span className=\"text-[10px] uppercase font-semibold text-slate-400 block tracking-wider\">\n                Extinguished on Behalf of\n              </span>\n              <div className=\"text-base font-bold text-emerald-300 mt-0.5\">\n                {credit.retiredDetails.beneficiary}\n              </div>\n              <div className=\"text-xs text-slate-400 italic mt-1\">\n                \"{credit.retiredDetails.reason}\"\n              </div>\n            </div>\n\n            {/* Specifics Grid */}\n            <div className=\"grid grid-cols-2 gap-3 text-left max-w-md mx-auto text-xs bg-slate-950/60 p-3 rounded-lg border border-slate-800/80\">\n              <div>\n                <span className=\"text-slate-400 text-[10px] block uppercase\">Credit Token ID</span>\n                <span className=\"font-mono font-bold text-white\">{credit.id}</span>\n              </div>\n              <div>\n                <span className=\"text-slate-400 text-[10px] block uppercase\">Provenance Site</span>\n                <span className=\"font-semibold text-slate-200\">{credit.siteName}</span>\n              </div>\n              <div>\n                <span className=\"text-slate-400 text-[10px] block uppercase\">Retirement Date</span>\n                <span className=\"font-mono text-slate-300\">{new Date(credit.retiredDetails.retiredAt).toLocaleDateString()}</span>\n              </div>\n              <div>\n                <span className=\"text-slate-400 text-[10px] block uppercase\">Methodology Standard</span>\n                <span className=\"text-emerald-400 font-semibold\">{credit.standard}</span>\n              </div>\n            </div>\n\n            {/* Cryptographic Burn Seal */}\n            <div className=\"pt-2 text-center\">\n              <div className=\"text-[10px] font-mono text-slate-400 truncate max-w-md mx-auto\">\n                Ledger Burn Tx: <span className=\"text-slate-300\">{credit.retiredDetails.burnTxHash}</span>\n              </div>\n              <div className=\"text-[10px] text-emerald-400 mt-1 flex items-center justify-center gap-1\">\n                <CheckCircle2 className=\"w-3 h-3\" />\n                <span>Immutable Proof: Extinguished on Indian Blue Carbon Blockchain</span>\n              </div>\n            </div>\n\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport { CarbonCredit } from \'../types\';\nimport { Award, CheckCircle2, ShieldCheck, Download, X, Printer, TreePine } from \'lucide-react\';\n\ninterface CertificateModalProps {\n  credit: CarbonCredit | null;\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const CertificateModal: React.FC<CertificateModalProps> = ({\n  credit,\n  isOpen,\n  onClose\n}) => {\n  if (!isOpen || !credit || !credit.retiredDetails) return null;\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#05080A]/85 backdrop-blur-md overflow-y-auto\">\n      <div className=\"bg-[#080D11] border border-[#1E293B] rounded-lg w-full max-w-2xl overflow-hidden shadow-[0_0_30px_rgba(0,0,0,0.8)] my-8 text-white font-mono\">\n        \n        {/* Top Control Bar */}\n        <div className=\"px-6 py-3 border-b border-[#1E293B] flex items-center justify-between bg-[#05080A]\">\n          <div className=\"flex items-center gap-2 text-xs font-bold text-[#00FF9C] uppercase tracking-widest\">\n            <ShieldCheck className=\"w-4 h-4\" />\n            <span>Official Gov. of India MRV Offset Proof</span>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={handlePrint}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 rounded text-xs uppercase tracking-wider bg-[#161F27] hover:bg-[#1E293B] text-[#E0E7EB] border border-[#1E293B] transition-colors cursor-pointer\"\n            >\n              <Printer className=\"w-3.5 h-3.5\" />\n              <span>Print / PDF</span>\n            </button>\n            <button\n              onClick={onClose}\n              className=\"p-1.5 rounded text-[#64748B] hover:text-white hover:bg-[#161F27] transition-colors cursor-pointer\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Certificate Ornamental Content */}\n        <div className=\"p-8 bg-[#05080A] border-2 border-[#1E293B] m-4 rounded relative\">\n          \n          {/* Subtle Background Emblem */}\n          <div className=\"absolute inset-0 flex items-center justify-center opacity-5 pointer-events-none\">\n            <TreePine className=\"w-72 h-72 text-[#00FF9C]\" />\n          </div>\n\n          <div className=\"relative text-center space-y-4\">\n            \n            {/* Header / Seal */}\n            <div className=\"flex flex-col items-center justify-center\">\n              <div className=\"w-14 h-14 rounded bg-[#00FF9C]/15 border border-[#00FF9C]/40 flex items-center justify-center text-[#00FF9C] mb-2 shadow-[0_0_15px_rgba(0,255,156,0.3)]\">\n                <Award className=\"w-8 h-8\" />\n              </div>\n              <span className=\"text-[10px] font-bold uppercase tracking-[0.25em] text-[#00FF9C]\">\n                National Blue Carbon Registry of India\n              </span>\n              <h2 className=\"text-xl font-bold text-white tracking-tight uppercase mt-1\">\n                Certificate of Carbon Retirement\n              </h2>\n              <div className=\"text-xs text-[#64748B] mt-1\">\n                Certificate ID: <span className=\"text-[#00FF9C] font-bold\">{credit.retiredDetails.certificateNumber}</span>\n              </div>\n            </div>\n\n            <div className=\"w-24 h-0.5 bg-[#00FF9C]/40 mx-auto my-2\"></div>\n\n            {/* Main Statement */}\n            <p className=\"text-xs text-[#94A3B8] max-w-lg mx-auto leading-relaxed\">\n              This document certifies the permanent on-chain retirement and environmental extinguishment of <strong className=\"text-white\">1.0 Metric Tonne of CO\342\202\202 Equivalent (tCO\342\202\202e)</strong> sequestered in verified Indian coastal mangrove wetlands.\n            </p>\n\n            {/* Beneficiary Highlight Box */}\n            <div className=\"p-4 rounded bg-[#080D11] border border-[#1E293B] max-w-md mx-auto text-center\">\n              <span className=\"text-[9px] uppercase font-bold text-[#64748B] block tracking-widest\">\n                Extinguished on Behalf of\n              </span>\n              <div className=\"text-sm font-bold text-[#00FF9C] mt-0.5 uppercase\">\n                {credit.retiredDetails.beneficiary}\n              </div>\n              <div className=\"text-xs text-[#94A3B8] italic mt-1 font-sans\">\n                \"{credit.retiredDetails.reason}\"\n              </div>\n            </div>\n\n            {/* Specifics Grid */}\n            <div className=\"grid grid-cols-2 gap-3 text-left max-w-md mx-auto text-xs bg-[#080D11] p-3.5 rounded border border-[#1E293B]\">\n              <div>\n                <span className=\"text-[#64748B] text-[9px] block uppercase tracking-wider\">Credit Token ID</span>\n                <span className=\"font-bold text-white\">{credit.id}</span>\n              </div>\n              <div>\n                <span className=\"text-[#64748B] text-[9px] block uppercase tracking-wider\">Provenance Site</span>\n                <span className=\"font-bold text-[#E0E7EB]\">{credit.siteName}</span>\n              </div>\n              <div>\n                <span className=\"text-[#64748B] text-[9px] block uppercase tracking-wider\">Retirement Date</span>\n                <span className=\"text-[#94A3B8]\">{new Date(credit.retiredDetails.retiredAt).toLocaleDateString()}</span>\n              </div>\n              <div>\n                <span className=\"text-[#64748B] text-[9px] block uppercase tracking-wider\">Methodology Standard</span>\n                <span className=\"text-[#00D1FF] font-bold\">{credit.standard}</span>\n              </div>\n            </div>\n\n            {/* Cryptographic Burn Seal */}\n            <div className=\"pt-2 text-center\">\n              <div className=\"text-[10px] text-[#64748B] truncate max-w-md mx-auto\">\n                Ledger Burn Tx: <span className=\"text-[#94A3B8]\">{credit.retiredDetails.burnTxHash}</span>\n              </div>\n              <div className=\"text-[10px] text-[#00FF9C] mt-1 flex items-center justify-center gap-1 uppercase tracking-wider\">\n                <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                <span>Immutable Proof: Extinguished on Indian Blue Carbon Ledger</span>\n              </div>\n            </div>\n\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
}
