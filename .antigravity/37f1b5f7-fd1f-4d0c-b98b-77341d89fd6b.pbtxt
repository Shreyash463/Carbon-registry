  file_change {
    absolute_path_uri: "file:///src/components/LedgerExplorer.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { LedgerBlock, LedgerVerificationResult } from \'../types\';\nimport { \n  ShieldCheck, \n  ShieldAlert, \n  Link, \n  AlertTriangle, \n  CheckCircle2, \n  RefreshCw, \n  Bug, \n  Wrench, \n  FileText, \n  ExternalLink,\n  ChevronDown,\n  ChevronUp,\n  Sparkles,\n  Lock\n} from \'lucide-react\';\n\ninterface LedgerExplorerProps {\n  ledger: LedgerBlock[];\n  verificationResult: LedgerVerificationResult | null;\n  onVerifyLedger: () => void;\n  isVerifying: boolean;\n  onTamperLedger: (blockIndex: number) => void;\n  onRepairLedger: () => void;\n}\n\nexport const LedgerExplorer: React.FC<LedgerExplorerProps> = ({\n  ledger,\n  verificationResult,\n  onVerifyLedger,\n  isVerifying,\n  onTamperLedger,\n  onRepairLedger\n}) => {\n  const [selectedBlockIndex, setSelectedBlockIndex] = useState<number | null>(null);\n  const [tamperTargetIndex, setTamperTargetIndex] = useState<number>(1);\n  const [tamperSuccessNotice, setTamperSuccessNotice] = useState<string | null>(null);\n\n  const isCompromised = verificationResult && !verificationResult.isValid;\n\n  const handleTamperClick = () => {\n    onTamperLedger(tamperTargetIndex);\n    setTamperSuccessNotice(`Deliberately mutated data payload inside Block #${tamperTargetIndex}. Click \"Verify Ledger Integrity\" to watch the cryptographic validator detect the broken chain!`);\n  };\n\n  const getBlockTypeBadge = (type: LedgerBlock[\'blockType\']) => {\n    switch (type) {\n      case \'GENESIS\':\n        return <span className=\"px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-300 border border-slate-700\">GENESIS</span>;\n      case \'CREDIT_MINT\':\n        return <span className=\"px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-300 border border-emerald-700\">CREDIT MINT</span>;\n      case \'BUFFER_REVERSAL_BURN\':\n        return <span className=\"px-2 py-0.5 rounded text-[10px] font-bold bg-red-950 text-red-300 border border-red-700\">REVERSAL BURN</span>;\n      case \'CREDIT_RETIREMENT\':\n        return <span className=\"px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-950 text-indigo-300 border border-indigo-700\">RETIREMENT</span>;\n      default:\n        return <span className=\"px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-400\">{type}</span>;\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      \n      {/* Top Header & Demo Control Center */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl\">\n        <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-800\">\n          <div>\n            <div className=\"flex items-center gap-2 text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-1\">\n              <ShieldCheck className=\"w-4 h-4\" />\n              <span>Permissioned Cryptographic Audit Trail</span>\n            </div>\n            <h2 className=\"text-xl font-bold text-white tracking-tight\">\n              Blockchain Ledger Explorer & Proof Engine\n            </h2>\n            <p className=\"text-xs text-slate-400 mt-1 max-w-2xl\">\n              Every carbon minting, buffer reserve allocation, retirement, and reversal event is committed to a cryptographically linked SHA-256 hash chain with Merkle proofs.\n            </p>\n          </div>\n\n          {/* Action buttons */}\n          <div className=\"flex flex-wrap items-center gap-2\">\n            <button\n              onClick={onVerifyLedger}\n              disabled={isVerifying}\n              className=\"flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition-colors cursor-pointer disabled:opacity-50 shadow-md shadow-emerald-950\"\n            >\n              {isVerifying ? (\n                <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n              ) : (\n                <CheckCircle2 className=\"w-3.5 h-3.5\" />\n              )}\n              <span>Verify Ledger Integrity</span>\n            </button>\n\n            <button\n              onClick={onRepairLedger}\n              className=\"flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors cursor-pointer\"\n            >\n              <Wrench className=\"w-3.5 h-3.5 text-slate-400\" />\n              <span>Restore Canonical Chain</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Live Hackathon Demonstration Simulator Tool */}\n        <div className=\"mt-4 pt-4 border-t border-slate-800/80 bg-slate-950/40 rounded-xl p-4\">\n          <div className=\"flex items-start justify-between gap-4\">\n            <div className=\"flex items-start gap-3\">\n              <div className=\"w-8 h-8 rounded-lg bg-red-950/80 border border-red-800/60 flex items-center justify-center text-red-400 shrink-0\">\n                <Bug className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <h4 className=\"text-xs font-bold text-slate-200 uppercase tracking-wide flex items-center gap-2\">\n                  <span>SIH Live Demo Tool: Simulate Data Tampering</span>\n                  <span className=\"text-[10px] font-normal px-2 py-0.5 rounded bg-red-950 text-red-300 border border-red-900\">\n                    Judge Proof Moment\n                  </span>\n                </h4>\n                <p className=\"text-xs text-slate-400 mt-0.5\">\n                  Test the mathematical tamper-proofing. Mutates the stored balance of a block without recomputing its hash to demonstrate how cryptographic chaining detects bad actors.\n                </p>\n              </div>\n            </div>\n\n            <div className=\"flex items-center gap-2 shrink-0\">\n              <select\n                value={tamperTargetIndex}\n                onChange={(e) => setTamperTargetIndex(Number(e.target.value))}\n                className=\"bg-slate-900 border border-slate-700 text-xs text-slate-200 rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-red-500\"\n              >\n                {ledger.filter(b => b.index > 0).map(b => (\n                  <option key={b.index} value={b.index}>\n                    Block #{b.index} ({b.blockType})\n                  </option>\n                ))}\n              </select>\n\n              <button\n                onClick={handleTamperClick}\n                className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-red-950 hover:bg-red-900 text-red-200 border border-red-800 transition-colors cursor-pointer\"\n              >\n                <Bug className=\"w-3.5 h-3.5 text-red-400\" />\n                <span>Tamper Block #{tamperTargetIndex}</span>\n              </button>\n            </div>\n          </div>\n\n          {tamperSuccessNotice && (\n            <div className=\"mt-3 p-2.5 rounded-lg bg-red-950/80 border border-red-800 text-xs text-red-200 flex items-center justify-between\">\n              <span className=\"flex items-center gap-2\">\n                <AlertTriangle className=\"w-4 h-4 text-red-400 shrink-0\" />\n                <span>{tamperSuccessNotice}</span>\n              </span>\n              <button \n                onClick={() => setTamperSuccessNotice(null)}\n                className=\"text-slate-400 hover:text-white text-xs underline ml-2\"\n              >\n                Dismiss\n              </button>\n            </div>\n          )}\n        </div>\n\n        {/* Verification Status Banner */}\n        {verificationResult && (\n          <div className={`mt-4 p-4 rounded-xl border flex items-start gap-3.5 ${\n            verificationResult.isValid\n              ? \'bg-emerald-950/40 border-emerald-700/60 text-emerald-200\'\n              : \'bg-red-950/70 border-red-600 text-red-100 animate-pulse\'\n          }`}>\n            <div className={`w-8 h-8 rounded-full flex items-center justify-center shrink-0 ${\n              verificationResult.isValid ? \'bg-emerald-500 text-slate-950\' : \'bg-red-600 text-white\'\n            }`}>\n              {verificationResult.isValid ? <CheckCircle2 className=\"w-5 h-5\" /> : <AlertTriangle className=\"w-5 h-5\" />}\n            </div>\n            <div className=\"flex-1\">\n              <div className=\"flex items-center justify-between\">\n                <h4 className=\"text-sm font-bold tracking-tight\">\n                  {verificationResult.isValid ? \'Ledger Chain 100% Valid & Intact\' : \'CRITICAL: Ledger Tampering Detected!\'}\n                </h4>\n                <span className=\"text-[11px] font-mono opacity-75\">\n                  Audited: {new Date(verificationResult.verifiedAt).toLocaleTimeString()}\n                </span>\n              </div>\n              <p className=\"text-xs mt-1 leading-relaxed opacity-90\">\n                {verificationResult.details}\n              </p>\n              {!verificationResult.isValid && verificationResult.firstInvalidBlockIndex !== null && (\n                <div className=\"mt-2 text-xs font-mono bg-red-900/60 p-2 rounded border border-red-700\">\n                  <div>First Invalid Block: <span className=\"font-bold text-white\">Block #{verificationResult.firstInvalidBlockIndex}</span></div>\n                  <div className=\"truncate\">Stored Hash: {verificationResult.actualHash}</div>\n                  <div className=\"truncate text-emerald-300\">Recomputed Canonical Hash: {verificationResult.expectedHash}</div>\n                </div>\n              )}\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Visual Hash-Chain Blocks */}\n      <div className=\"space-y-4\">\n        <div className=\"flex items-center justify-between text-xs text-slate-400 px-1\">\n          <span className=\"font-semibold uppercase tracking-wider\">\n            Ledger Blocks Sequence ({ledger.length} Blocks)\n          </span>\n          <span>Tip Block: #{ledger.length - 1}</span>\n        </div>\n\n        {ledger.map((block, idx) => {\n          const auditInfo = verificationResult?.chainAudit.find(a => a.index === block.index);\n          const isInvalid = auditInfo && !auditInfo.isValid;\n          const isSelected = selectedBlockIndex === block.index;\n\n          return (\n            <div key={block.index} className=\"relative\">\n              \n              {/* Connector Link Line to Previous Block */}\n              {idx > 0 && (\n                <div className=\"flex items-center justify-center my-1\">\n                  <div className={`flex items-center gap-1.5 px-3 py-0.5 rounded-full text-[10px] font-mono border ${\n                    isInvalid \n                      ? \'bg-red-950 text-red-300 border-red-600\' \n                      : \'bg-slate-950 text-emerald-400/80 border-slate-800\'\n                  }`}>\n                    <Link className=\"w-3 h-3\" />\n                    <span>Prev Hash Link: {block.previousHash.slice(0, 12)}...{block.previousHash.slice(-8)}</span>\n                  </div>\n                </div>\n              )}\n\n              {/* Block Card */}\n              <div \n                className={`bg-slate-900 border rounded-xl overflow-hidden transition-all ${\n                  isInvalid \n                    ? \'border-red-500 ring-2 ring-red-500/50 shadow-lg shadow-red-950/40\' \n                    : (block.tampered \n                        ? \'border-amber-500\' \n                        : \'border-slate-800 hover:border-slate-700\')\n                }`}\n              >\n                {/* Block Card Top Row */}\n                <div className=\"p-4 flex flex-col md:flex-row md:items-center justify-between gap-3\">\n                  <div className=\"flex items-center gap-3\">\n                    <div className={`w-9 h-9 rounded-lg flex items-center justify-center font-mono font-bold text-sm ${\n                      block.index === 0 \n                        ? \'bg-slate-800 text-slate-300\' \n                        : (isInvalid ? \'bg-red-950 text-red-300 border border-red-600\' : \'bg-emerald-950 text-emerald-300 border border-emerald-800\')\n                    }`}>\n                      #{block.index}\n                    </div>\n\n                    <div>\n                      <div className=\"flex items-center gap-2\">\n                        {getBlockTypeBadge(block.blockType)}\n                        {block.siteName && (\n                          <span className=\"text-xs font-semibold text-white\">\n                            {block.siteName}\n                          </span>\n                        )}\n                        {block.tampered && (\n                          <span className=\"text-[10px] font-bold px-1.5 py-0.5 rounded bg-red-950 text-red-300 border border-red-700 animate-pulse\">\n                            Tampered\n                          </span>\n                        )}\n                      </div>\n                      <div className=\"text-[11px] text-slate-400 font-mono mt-0.5\">\n                        {new Date(block.timestamp).toUTCString()}\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Hash snapshot */}\n                  <div className=\"flex items-center gap-3\">\n                    <div className=\"text-right hidden sm:block\">\n                      <span className=\"text-[10px] text-slate-400 block uppercase font-mono\">Block Hash (SHA-256)</span>\n                      <span className={`text-xs font-mono font-semibold ${isInvalid ? \'text-red-400\' : \'text-emerald-400\'}`}>\n                        {block.hash.slice(0, 16)}...{block.hash.slice(-12)}\n                      </span>\n                    </div>\n\n                    <button\n                      onClick={() => setSelectedBlockIndex(isSelected ? null : block.index)}\n                      className=\"p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors cursor-pointer text-xs flex items-center gap-1\"\n                    >\n                      <span>{isSelected ? \'Hide\' : \'Inspect\'}</span>\n                      {isSelected ? <ChevronUp className=\"w-3.5 h-3.5\" /> : <ChevronDown className=\"w-3.5 h-3.5\" />}\n                    </button>\n                  </div>\n                </div>\n\n                {/* Block Key Payload Highlights */}\n                <div className=\"px-4 py-2.5 bg-slate-950/60 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-2 text-xs\">\n                  <div className=\"flex items-center gap-4 text-slate-300\">\n                    {block.data.totalTCO2e !== undefined && (\n                      <div>\n                        <span className=\"text-slate-400 text-[11px]\">Tonnage: </span>\n                        <span className=\"font-semibold text-emerald-400\">{block.data.totalTCO2e.toLocaleString()} tCO\342\202\202e</span>\n                      </div>\n                    )}\n                    {block.data.tradeableCredits !== undefined && (\n                      <div>\n                        <span className=\"text-slate-400 text-[11px]\">Tradeable (80%): </span>\n                        <span className=\"font-semibold text-slate-200\">{block.data.tradeableCredits.toLocaleString()}</span>\n                      </div>\n                    )}\n                    {block.data.bufferCredits !== undefined && (\n                      <div>\n                        <span className=\"text-slate-400 text-[11px]\">Buffer (20%): </span>\n                        <span className=\"font-semibold text-amber-400\">{block.data.bufferCredits.toLocaleString()}</span>\n                      </div>\n                    )}\n                    {block.data.retiredCreditId && (\n                      <div>\n                        <span className=\"text-slate-400 text-[11px]\">Retired Token: </span>\n                        <span className=\"font-mono text-indigo-300\">{block.data.retiredCreditId}</span>\n                      </div>\n                    )}\n                    {block.data.burnedReserveCredits !== undefined && (\n                      <div>\n                        <span className=\"text-slate-400 text-[11px]\">Burned Reserve: </span>\n                        <span className=\"font-semibold text-red-400\">-{block.data.burnedReserveCredits.toLocaleString()}</span>\n                      </div>\n                    )}\n                  </div>\n\n                  <div className=\"text-[11px] text-slate-400 truncate max-w-md italic\">\n                    {block.data.notes}\n                  </div>\n                </div>\n\n                {/* Expanded Details / JSON Inspector */}\n                {isSelected && (\n                  <div className=\"p-4 bg-slate-950 border-t border-slate-800 space-y-3 text-xs\">\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n                      <div>\n                        <span className=\"text-[11px] font-semibold uppercase text-slate-400 block mb-1\">Cryptographic Headers</span>\n                        <div className=\"space-y-1.5 font-mono text-[11px] bg-slate-900 p-2.5 rounded-lg border border-slate-800\">\n                          <div><span className=\"text-slate-400\">Index:</span> {block.index}</div>\n                          <div className=\"truncate\"><span className=\"text-slate-400\">Hash:</span> <span className=\"text-emerald-400\">{block.hash}</span></div>\n                          <div className=\"truncate\"><span className=\"text-slate-400\">PrevHash:</span> {block.previousHash}</div>\n                          <div className=\"truncate\"><span className=\"text-slate-400\">MerkleRoot:</span> {block.merkleRoot}</div>\n                          <div className=\"truncate\"><span className=\"text-slate-400\">ValidatorSig:</span> {block.validatorSignature}</div>\n                        </div>\n                      </div>\n\n                      <div>\n                        <span className=\"text-[11px] font-semibold uppercase text-slate-400 block mb-1\">Data Payload JSON</span>\n                        <pre className=\"p-2.5 rounded-lg bg-slate-900 border border-slate-800 font-mono text-[11px] text-emerald-300 overflow-x-auto max-h-36\">\n                          {JSON.stringify(block.data, null, 2)}\n                        </pre>\n                      </div>\n                    </div>\n                  </div>\n                )}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n    </div>\n  );\n};\n"
    }
